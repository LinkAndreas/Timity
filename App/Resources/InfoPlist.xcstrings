    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "NSCalendarsFullAccessUsageDescription",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity liest deine bevorstehenden Termine, wenn du sie aus dem Kalender importierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timity reads your upcoming events when you import them from Calendar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity lit vos évènements à venir lorsque vous les importez depuis Calendrier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity lee tus próximos eventos cuando los importas desde Calendario."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "NSContactsUsageDescription",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity liest Geburtstage und Jahrestage aus deinen Kontakten, wenn du sie importierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timity reads birthdays and anniversaries from your contacts when you import them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity lit les anniversaires de vos contacts lorsque vous les importez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity lee los cumpleaños y aniversarios de tus contactos cuando los importas."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity verwendet deinen Standort, um Sonnenaufgang, Sonnenuntergang und Dämmerung für deinen Ort zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timity uses your location to calculate sunrise, sunset and twilight where you are."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity utilise votre position pour calculer le lever et le coucher du soleil et le crépuscule là où vous êtes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity usa tu ubicación para calcular el amanecer, el atardecer y el crepúsculo donde estás."
          }
        }
      }
    },
