          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vie en semaines montre chaque semaine d’une vie par un point. Votre date de naissance reste sur vos appareils."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
