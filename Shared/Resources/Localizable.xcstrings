    "editor.showsHowMuchOfThe" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt, wie viel der Wartezeit vom gewählten Datum bis zum Ereignis vergangen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows how much of the wait has passed, from the date you choose to the event."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra qué parte de la espera ha pasado, desde la fecha que elijas hasta el evento."
          }
        },
        "fr" : {
          "stringUnit" : {
