        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在也是原生 Mac App，菜单栏中显示你接下来的倒计时。"
          }
        }
      }
    },
    "versionHistory.4_9_67.note3" : {
