    "watch.addEventsInTimityOn" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Ereignisse in Timity auf deinem iPhone oder iPad hinzu. Sie erscheinen hier über iCloud."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add events in Timity on your iPhone or iPad. They appear here through iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade eventos en Timity en tu iPhone o iPad. Aparecen aquí a través de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des événements dans Timity sur ton iPhone ou iPad. Ils apparaissent ici via iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi eventi in Timity sul tuo iPhone o iPad. Compaiono qui tramite iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneまたはiPadのTimityでイベントを追加してください。iCloud経由でここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 또는 iPad의 Timity에서 이벤트를 추가하세요. iCloud를 통해 여기에 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg gebeurtenissen toe in Timity op je iPhone of iPad. Ze verschijnen hier via iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione eventos no Timity no iPhone ou iPad. Eles aparecem aqui pelo iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляй события в Timity на iPhone или iPad. Они появятся здесь через iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 或 iPad 上的 Timity 中添加事件。它们会通过 iCloud 显示在这里。"
          }
        }
      }
    },
    "watch.allowTimityToUseYour" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Timity in den Einstellungen der Watch, deinen Standort zu verwenden, um Sonnenauf- und -untergang zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Timity to use your location in the Watch's Settings to see sunrise and sunset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a Timity usar tu ubicación en Ajustes del Apple Watch para ver el amanecer y el atardecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise Timity à utiliser ta position dans les réglages de la Watch pour voir le lever et le coucher du soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Timity di usare la tua posizione nelle Impostazioni di Apple Watch per vedere alba e tramonto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日の出と日の入りを表示するには、Apple Watchの「設定」でTimityに位置情報の使用を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일출 및 일몰 시간을 보려면 Watch의 설정에서 Timity가 위치를 사용하도록 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef Timity in Instellingen op de Watch toegang tot je locatie om zonsopkomst en zonsondergang te zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Timity use a sua localização nos Ajustes do Watch para ver o nascer e o pôr do sol."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши Timity доступ к геопозиции в Настройках на Apple Watch, чтобы видеть время восхода и заката."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手表的“设置”中允许 Timity 使用你的位置，即可查看日出和日落时间。"
          }
        }
      }
    },
    "watch.icloudSyncIsOffIn" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die iCloud-Synchronisierung ist in Timity auf deinem iPhone aus. Schalte sie dort ein, um deine Ereignisse hier zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sync is off in Timity on your iPhone. Turn it on there to see your events here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización con iCloud está desactivada en Timity en tu iPhone. Actívala allí para ver tus eventos aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation iCloud est désactivée dans Timity sur ton iPhone. Active-la pour voir tes événements ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione iCloud è disattivata in Timity sul tuo iPhone. Attivala lì per vedere qui i tuoi eventi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのTimityでiCloud同期がオフになっています。ここにイベントを表示するには、iPhoneでオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 Timity에서 iCloud 동기화가 꺼져 있어요. 여기에서 이벤트를 보려면 iPhone에서 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synchronisatie staat uit in Timity op je iPhone. Zet die daar aan om je gebeurtenissen hier te zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização com o iCloud está desativada no Timity no seu iPhone. Ative-a lá para ver os seus eventos aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация с iCloud выключена в Timity на iPhone. Включи её там, чтобы видеть свои события здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 上的 Timity 已关闭 iCloud 同步。在 iPhone 上打开同步，即可在这里查看你的事件。"
          }
        }
      }
    },
    "watch.openTimityOnYourIPhone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Timity auf deinem iPhone und schließe die Begrüßung ab. Diese Watch synchronisiert dann genauso wie dein iPhone; Ereignisse, die du hier hinzufügst, bleiben erhalten und werden mit synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Timity on your iPhone and finish the welcome. This Watch then syncs just as your iPhone does; events you add here stay and sync along."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Timity en tu iPhone y termina la bienvenida. Este Watch se sincronizará igual que tu iPhone; los eventos que añadas aquí se conservan y se sincronizan también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Timity sur ton iPhone et termine l’accueil. Cette Watch se synchronise ensuite comme ton iPhone ; les événements ajoutés ici sont conservés et synchronisés aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Timity sul tuo iPhone e completa il benvenuto. Questo Apple Watch si sincronizzerà come il tuo iPhone; gli eventi che aggiungi qui restano e vengono sincronizzati anch’essi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneでTimityを開き、初期設定を完了してください。その後、このApple WatchはiPhoneと同じように同期します。ここで追加したイベントも保持され、同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 Timity를 열고 시작 화면을 완료하세요. 그러면 이 Watch도 iPhone과 똑같이 동기화되며, 여기에서 추가한 이벤트도 유지되고 함께 동기화돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Timity op je iPhone en rond de welkomstschermen af. Deze Watch synchroniseert dan net als je iPhone; gebeurtenissen die je hier toevoegt, blijven bewaard en worden mee gesynchroniseerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o Timity no iPhone e conclua as boas-vindas. Este Watch então sincroniza da mesma forma que o seu iPhone; os eventos que você adicionar aqui permanecem e são sincronizados também."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открой Timity на iPhone и заверши приветствие. После этого Apple Watch будут синхронизироваться так же, как iPhone; события, добавленные здесь, сохранятся и тоже синхронизируются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上打开 Timity 并完成欢迎设置。之后这只手表会和 iPhone 一样同步；你在这里添加的事件会保留并同步。"
          }
        }
      }
    },
