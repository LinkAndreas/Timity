    "versionHistory.3_0.note4" : {
      "comment" : "Release note 4 of Timity 3.0, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Menü ist jetzt der erste Bildschirm und damit leichter zugänglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The menu is now the first screen, so it’s always within reach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El menú es ahora la primera pantalla, así que siempre está a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le menu est désormais le premier écran, pour l’avoir toujours sous la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il menu ora è la prima schermata, così è sempre a portata di mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューが最初の画面になり、いつでもすぐに使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 메뉴가 첫 화면이므로 언제나 바로 사용할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het menu is nu het eerste scherm, zodat het altijd binnen handbereik is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O menu agora é a primeira tela, então está sempre ao alcance."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меню теперь — первый экран, поэтому оно всегда под рукой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单现为第一个屏幕，随时触手可及。"
          }
        }
      }
    },
    "versionHistory.3_0.note5" : {
      "comment" : "Release note 5 of Timity 3.0, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ergebnisse sind besser lesbar, und Bilder, die einem Ereignis zugeordnet sind, erscheinen jetzt im Ergebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculator results are easier to read, and images assigned to an event now show in the result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados de las calculadoras se leen mejor, y las imágenes asignadas a un evento ahora aparecen en el resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats des calculateurs sont plus lisibles, et les images associées à un événement apparaissent désormais dans le résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I risultati dei calcolatori sono più facili da leggere e le immagini assegnate a un evento ora compaiono nel risultato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算結果が読みやすくなり、イベントに設定した画像が結果に表示されるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계산기 결과를 더 쉽게 읽을 수 있으며, 이벤트에 지정한 이미지가 결과에 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resultaten van de calculators zijn makkelijker te lezen, en afbeeldingen bij een gebeurtenis verschijnen nu in het resultaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os resultados das calculadoras estão mais fáceis de ler, e as imagens atribuídas a um evento agora aparecem no resultado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результаты калькуляторов легче читать, а изображения, назначенные событию, теперь видны в результате."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计算器结果更易阅读，为事件指定的图像现在也会显示在结果中。"
          }
        }
      }
    },
    "versionHistory.3_0.note6" : {
      "comment" : "Release note 6 of Timity 3.0, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity ist jetzt für alle kostenlos – vielen Dank für euer wertvolles Feedback und eure Unterstützung!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity is now free for everyone — thank you for your valuable feedback and support!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity ahora es gratis para todos. ¡Gracias por tus valiosos comentarios y tu apoyo!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity est désormais gratuit pour tous. Merci pour tes précieux retours et ton soutien !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity ora è gratuito per tutti: grazie per il tuo prezioso feedback e il tuo supporto!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timityは誰でも無料で使えるようになりました。貴重なフィードバックと応援、ありがとうございます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 모든 사용자가 Timity를 무료로 사용할 수 있어요. 소중한 피드백과 응원에 감사드려요!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity is nu gratis voor iedereen – bedankt voor je waardevolle feedback en steun!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Timity agora é gratuito para todos — obrigado pelo seu valioso feedback e apoio!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity теперь бесплатен для всех — спасибо за ценные отзывы и поддержку!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity 现在对所有人免费，感谢你宝贵的反馈和支持！"
          }
        }
      }
    },
    "versionHistory.3_0.note7" : {
      "comment" : "Release note 7 of Timity 3.0, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity startet jetzt mit einem dunklen Theme; wenn du ein helles bevorzugst, stellst du es in den Einstellungen um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity now starts with a dark theme; if you prefer a light one, change it in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity empieza ahora con un tema oscuro; si prefieres uno claro, cámbialo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
