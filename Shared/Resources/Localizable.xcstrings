    "tips.theMenuSharesTheCountdown" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im •••-Menü kannst du den Countdown als Bild teilen, zum Kalender hinzufügen oder neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ••• menu shares the countdown as an image, adds it to Calendar and starts a count over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el menú •••, comparte la cuenta atrás como imagen, añádela a Calendario o vuelve a empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le menu •••, partage le compte à rebours en image, ajoute-le à Calendrier ou relance le décompte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il menu ••• condivide il conto alla rovescia come immagine, lo aggiunge a Calendario e fa ripartire un conteggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "•••メニューから、カウントダウンを画像として共有したり、カレンダーに追加したり、カウントをやり直したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "••• 메뉴에서 카운트다운을 이미지로 공유하고, 캘린더에 추가하고, 다시 셀 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via het •••-menu deel je de countdown als afbeelding, zet je hem in Agenda en begin je opnieuw met tellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O menu ••• compartilha a contagem regressiva como imagem, a adiciona ao Calendário e recomeça uma contagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меню ••• позволяет поделиться обратным отсчётом как изображением, добавить его в Календарь и начать отсчёт заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 ••• 菜单，可以将倒计时以图像共享、添加到日历，或重新开始计数。"
          }
        }
      }
    },
