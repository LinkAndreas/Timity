        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cumpleaños se repiten cada año. Para contactos sin año de nacimiento, Timity cuenta sin mostrar la edad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anniversaires se répètent chaque année. Pour les contacts sans année de naissance, Timity décompte sans afficher d’âge."
          }
        }
      }
    },
