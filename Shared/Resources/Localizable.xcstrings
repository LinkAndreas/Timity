    "astronomy.seeWhenTheSunRises" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wann die Sonne auf- und untergeht, wann goldene und blaue Stunde sind und wann es dämmert – dort, wo du bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See when the sun rises and sets, golden and blue hour, and twilight where you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta cuándo sale y se pone el sol, la hora dorada y la azul, y el crepúsculo donde estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vois quand le soleil se lève et se couche, l’heure dorée et l’heure bleue, et le crépuscule là où tu es."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri quando sorge e tramonta il sole, l’ora d’oro, l’ora blu e il crepuscolo dove ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地の日の出と日の入り、ゴールデンアワーとブルーアワー、薄明の時刻を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치의 일출 및 일몰, 골든 아워와 블루 아워, 박명 시간을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie waar je bent wanneer de zon opkomt en ondergaat, wanneer het gouden en blauwe uur is en wanneer het schemert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja quando o sol nasce e se põe, a hora dourada e a azul e o crepúsculo onde você está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узнай, когда восходит и заходит солнце, когда наступают золотой и синий час и сумерки там, где ты находишься."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看你所在地的日出日落、黄金时刻、蓝调时刻和晨昏蒙影。"
          }
        }
      }
    },
