    "sync.theEventsInICloudAre" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ereignisse in iCloud werden durch die auf diesem Gerät ersetzt, und deine anderen Geräte erhalten sie von dort. Änderungen, die nur deine anderen Geräte haben, gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The events in iCloud are replaced with the ones on this device, and your other devices get them from there. Changes only your other devices have are lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos de iCloud se sustituyen por los de este dispositivo, y tus otros dispositivos los reciben desde allí. Se pierden los cambios que solo tengan tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements d’iCloud sont remplacés par ceux de cet appareil, et vos autres appareils les reçoivent depuis iCloud. Les modifications présentes uniquement sur vos autres appareils sont perdues."
          }
        }
      }
    },
    "sync.theEventsOnThisDevice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ereignisse auf diesem Gerät werden entfernt und erneut aus iCloud geladen. Noch nicht synchronisierte Änderungen gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The events on this device are removed and downloaded again from iCloud. Changes that haven't synced yet are lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos de este dispositivo se eliminan y se descargan de nuevo de iCloud. Se pierden los cambios que aún no se hayan sincronizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements de cet appareil sont supprimés puis retéléchargés depuis iCloud. Les modifications pas encore synchronisées sont perdues."
          }
        }
      }
    },
