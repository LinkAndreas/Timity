          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idéal pour les anniversaires : Timity décompte jusqu’au prochain et indique combien d’années il marque."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfecto para cumpleaños y aniversarios: Timity cuenta hasta el siguiente y muestra cuántos años se cumplen."
