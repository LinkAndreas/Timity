    "versionHistory.4_10_0.note1" : {
      "comment" : "Release note 1 of Timity 4.10.0, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity ist jetzt komplett kostenlos: keine Trinkgelder und Abos mehr – alle Funktionen und alle App-Icons sind für alle frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity is now completely free: no more tips or subscriptions — every feature and every app icon is free for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity ahora es totalmente gratis: sin propinas ni suscripciones; todas las funciones y todos los iconos de la app son gratis para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity est désormais entièrement gratuit : fini les pourboires et les abonnements, toutes les fonctions et toutes les icônes de l’app sont gratuites pour tous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity ora è completamente gratuito: niente più mance né abbonamenti, ogni funzione e ogni icona dell’app sono gratuite per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timityは完全に無料になりました。チップやサブスクリプションはなくなり、すべての機能とすべてのAppアイコンを誰でも無料で使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 Timity가 완전히 무료예요. 팁이나 구독 없이 모든 기능과 모든 앱 아이콘을 누구나 무료로 사용할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity is nu helemaal gratis: geen fooien of abonnementen meer – elke functie en elk appsymbool is gratis voor iedereen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Timity agora é totalmente gratuito: sem gorjetas nem assinaturas — todos os recursos e todos os ícones do app são gratuitos para todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity теперь полностью бесплатен: никаких чаевых и подписок — все функции и все значки приложения бесплатны для всех."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity 现已完全免费：不再有打赏或订阅，所有功能和 App 图标对所有人免费。"
          }
        }
      }
    },
    "versionHistory.4_10_0.note2" : {
      "comment" : "Release note 2 of Timity 4.10.0, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle dein App-Icon direkt unter Einstellungen › App-Icon, mit allen Icons auf einen Blick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose your app icon right in Settings › App Icon, with every icon at a glance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el icono de la app directamente en Ajustes › Icono de la app, con todos los iconos a la vista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis l’icône de l’app directement dans Réglages › Icône de l’app, avec toutes les icônes d’un coup d’œil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli l’icona dell’app direttamente in Impostazioni › Icona app, con tutte le icone a colpo d’occhio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」›「Appアイコン」で、すべてのアイコンを一覧しながらAppアイコンを直接選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › 앱 아이콘에서 모든 아이콘을 한눈에 보며 바로 앱 아이콘을 선택할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies je appsymbool direct in Instellingen › Appsymbool, met alle symbolen in één oogopslag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o ícone do app diretamente em Ajustes › Ícone do app, com todos os ícones à vista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирай значок приложения прямо в разделе «Настройки» › «Значок приложения» — все значки сразу перед глазами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接在“设置”›“App 图标”中选择 App 图标，所有图标一目了然。"
          }
        }
      }
    },
    "versionHistory.4_10_0.note3" : {
      "comment" : "Release note 3 of Timity 4.10.0, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Akzentfarbe bleibt, wie du sie eingestellt hast, wenn du das App-Icon wechselst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
