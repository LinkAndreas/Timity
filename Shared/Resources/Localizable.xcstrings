    "calc.lifeInWeeks.lifeInWeeksDrawsEvery" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leben in Wochen zeigt jede Woche eines Lebens als Punkt. Dein Geburtstag bleibt auf deinen Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Life in Weeks draws every week of a life as a dot. Your birthday stays on your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vida en semanas dibuja cada semana de una vida como un punto. Tu cumpleaños se queda en tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vie en semaines représente chaque semaine d’une vie par un point. Ta date de naissance reste sur tes appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vita in settimane rappresenta ogni settimana di una vita come un punto. Il tuo compleanno resta sui tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「人生の週」は、人生のすべての週を点で描きます。誕生日はお使いのデバイスにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주 단위 인생은 인생의 모든 주를 점으로 그려 줘요. 생일 정보는 내 기기에만 저장돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leven in weken tekent elke week van een leven als een stip. Je verjaardag blijft op je apparaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vida em semanas desenha cada semana de uma vida como um ponto. O seu aniversário fica nos seus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Жизнь в неделях» рисует каждую неделю жизни точкой. Твой день рождения хранится только на твоих устройствах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“人生周历”将人生的每一周画成一个点。你的生日只保存在你的设备上。"
          }
        }
      }
    },
