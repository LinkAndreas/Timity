    "calc.addSubtract.hoursAndMinutesAreTime" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stunden und Minuten zählen die tatsächlich vergangene Zeit, auch bei der Zeitumstellung. Ein Monat nach dem 31. Januar ist der letzte Tag im Februar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hours and minutes count the time that actually passes, even when the clocks change. A month after 31 January is the last day of February."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas y los minutos cuentan el tiempo que pasa realmente, incluso con el cambio de hora. Un mes después del 31 de enero es el último día de febrero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures et les minutes comptent le temps réellement écoulé, même lors du changement d’heure. Un mois après le 31 janvier, c’est le dernier jour de février."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ore e minuti contano il tempo che passa davvero, anche quando cambia l’ora. Un mese dopo il 31 gennaio è l’ultimo giorno di febbraio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間と分は、時計の切り替えがあっても実際に経過する時間で数えます。1月31日の1か月後は2月の末日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간과 분은 시계가 바뀌어도 실제로 흐른 시간을 세요. 1월 31일의 한 달 후는 2월의 마지막 날이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uren en minuten tellen de tijd die echt verstrijkt, ook als de klok verzet wordt. Een maand na 31 januari is de laatste dag van februari."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horas e minutos contam o tempo que realmente passa, mesmo quando muda o horário. Um mês depois de 31 de janeiro é o último dia de fevereiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часы и минуты учитывают реально прошедшее время, даже при переводе часов. Через месяц после 31 января — последний день февраля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小时和分钟按实际经过的时间计算，即使时钟调整也是如此。1 月 31 日之后一个月是 2 月的最后一天。"
          }
        }
      }
    },
