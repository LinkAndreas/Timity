    "events.addBirthdaysTripsAndDeadlines" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Geburtstage, Reisen und Fristen hinzu und sieh, wie lange es noch dauert – oder wie lange es her ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add birthdays, trips and deadlines to see how long until they come — or since they happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade cumpleaños, viajes y plazos para ver cuánto falta, o cuánto ha pasado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute anniversaires, voyages et échéances pour voir combien de temps il reste — ou depuis quand."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi compleanni, viaggi e scadenze per vedere quanto manca, o quanto tempo è passato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誕生日や旅行、期限を追加すると、その日まであとどれくらいか、またはその日からどれくらい経ったかがわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생일, 여행, 마감일을 추가하여 얼마나 남았는지, 또는 얼마나 지났는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg verjaardagen, reizen en deadlines toe en zie hoelang het nog duurt – of hoelang het geleden is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione aniversários, viagens e prazos para ver quanto falta para eles — ou quanto tempo já passou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь дни рождения, поездки и сроки, чтобы видеть, сколько до них осталось — или сколько прошло с тех пор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加生日、旅行和截止日期，查看距离它们还有多久，或已经过去多久。"
          }
        }
      }
    },
