          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce que vous constatez. Timity vous guide vers la solution, en commençant par les étapes les plus sûres. Le rapport contient l’état de la synchronisation, pas vos évènements."
          }
        }
      }
    },
