          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り替えスイッチより下のどこかで横にスワイプすると、もう一方に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전환 버튼 아래 아무 곳에서나 옆으로 쓸어넘겨 전환하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg ergens onder de schakelaar opzij om van de een naar de ander te gaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para o lado em qualquer lugar abaixo do seletor para passar de um para o outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахни в сторону в любом месте под переключателем, чтобы перейти от одного к другому."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在切换开关下方任意位置左右轻扫，即可在两者之间切换。"
          }
        }
      }
    },
