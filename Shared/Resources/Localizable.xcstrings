    "onboarding.timityCountsDownToIt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity zählt jedes Jahr bis dahin herunter, und „Leben in Wochen“ zeigt jede Woche deines Lebens. Dein Geburtstag bleibt privat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity counts down to it every year, and Life in Weeks draws every week of your life. It stays private to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity cuenta los días que faltan cada año, y La vida en semanas dibuja cada semana de tu vida. Solo lo ves tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity fait le compte à rebours chaque année, et La vie en semaines dessine chaque semaine de ta vie. Cette date reste privée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity fa il conto alla rovescia ogni anno e La vita in settimane rappresenta ogni settimana della tua vita. Resta privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timityが毎年誕生日までカウントダウンし、「人生の週」が人生のすべての週を描きます。誕生日はあなただけのものとして保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity가 매년 생일까지 카운트다운하고, 주 단위 인생이 인생의 모든 주를 그려 줘요. 이 정보는 나만 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity telt er elk jaar naar af, en Leven in weken tekent elke week van je leven. Het blijft privé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Timity faz a contagem regressiva para ele todo ano, e “A vida em semanas” desenha cada semana da sua vida. Isso fica só com você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity будет вести обратный отсчёт до него каждый год, а «Жизнь в неделях» нарисует каждую неделю твоей жизни. Эти данные видишь только ты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity 每年为它倒计时，“人生周历”会画出你人生的每一周。这些信息只属于你。"
          }
        }
      }
    },
