    "astronomy.allowTimityToUseYour" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Timity in den Einstellungen, deinen Standort zu verwenden, um Sonnenauf- und -untergang für deinen Ort zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Timity to use your location in Settings to see sunrise and sunset where you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a Timity usar tu ubicación en Ajustes para ver el amanecer y el atardecer donde estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise Timity à utiliser ta position dans Réglages pour voir le lever et le coucher du soleil là où tu es."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Timity di usare la tua posizione in Impostazioni per vedere alba e tramonto dove ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地の日の出と日の入りを表示するには、「設定」でTimityに位置情報の使用を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치의 일출 및 일몰 시간을 보려면 설정에서 Timity가 위치를 사용하도록 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef Timity in Instellingen toegang tot je locatie om te zien wanneer de zon opkomt en ondergaat waar je bent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Timity use a sua localização em Ajustes para ver o nascer e o pôr do sol onde você está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши Timity доступ к геопозиции в Настройках, чтобы видеть время восхода и заката там, где ты находишься."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中允许 Timity 使用你的位置，即可查看你所在地的日出和日落时间。"
          }
        }
      }
    },
    "astronomy.allowTimityToUseYour.mac" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Timity to use your location in System Settings › Privacy & Security › Location Services to see sunrise and sunset where you are."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Timity in den Systemeinstellungen unter „Datenschutz & Sicherheit“ › „Ortungsdienste“, deinen Standort zu verwenden, um Sonnenauf- und -untergang für deinen Ort zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a Timity usar tu ubicación en Ajustes del Sistema › Privacidad y seguridad › Localización para ver el amanecer y el atardecer donde estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise Timity à utiliser ta position dans Réglages Système › Confidentialité et sécurité › Service de localisation pour voir le lever et le coucher du soleil là où tu es."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Timity di usare la tua posizione in Impostazioni di Sistema › Privacy e sicurezza › Localizzazione per vedere alba e tramonto dove ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地の日の出と日の入りを表示するには、「システム設定」›「プライバシーとセキュリティ」›「位置情報サービス」でTimityに位置情報の使用を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치의 일출 및 일몰 시간을 보려면 시스템 설정 › 개인정보 보호 및 보안 › 위치 서비스에서 Timity가 위치를 사용하도록 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef Timity in Systeeminstellingen › Privacy en beveiliging › Locatievoorzieningen toegang tot je locatie om te zien wanneer de zon opkomt en ondergaat waar je bent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Timity use a sua localização em Ajustes do Sistema › Privacidade e Segurança › Serviços de Localização para ver o nascer e o pôr do sol onde você está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши Timity доступ к геопозиции в меню «Системные настройки» › «Конфиденциальность и безопасность» › «Службы геолокации», чтобы видеть время восхода и заката там, где ты находишься."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置”›“隐私与安全性”›“定位服务”中允许 Timity 使用你的位置，即可查看你所在地的日出和日落时间。"
          }
        }
      }
    },
    "astronomy.astronomical" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astronomisch"
          }
