    "watch.openTimityOnYourIPhone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Timity auf deinem iPhone und schließe die Begrüßung ab. Diese Watch synchronisiert dann genauso wie dein iPhone; Ereignisse, die du hier hinzufügst, bleiben erhalten und werden mit synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Timity on your iPhone and finish the welcome. This Watch then syncs just as your iPhone does; events you add here stay and sync along."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Timity en tu iPhone y termina la bienvenida. Este Watch se sincronizará igual que tu iPhone; los eventos que añadas aquí se conservan y se sincronizan también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Timity sur votre iPhone et terminez l’accueil. Cette Watch se synchronise ensuite comme votre iPhone ; les événements ajoutés ici sont conservés et synchronisés aussi."
          }
        }
      }
    },
