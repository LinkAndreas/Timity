    "whatsNew.planFromYourWakeUp" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan from your wake-up time or your bedtime, with your own sleep cycle and a nightly reminder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane ab deiner Aufwachzeit oder Schlafenszeit, mit deinem eigenen Schlafzyklus und einer abendlichen Erinnerung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica desde tu hora de despertar o de acostarte, con tu propio ciclo de sueño y un recordatorio cada noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez à partir de votre heure de réveil ou de coucher, avec votre propre cycle de sommeil et un rappel chaque soir."
          }
        }
      }
    },
    "whatsNew.progressAtAGlance" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress at a Glance"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortschritt auf einen Blick"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progreso de un vistazo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La progression en un coup d’œil"
          }
        }
      }
    },
    "whatsNew.seeAnyDateInThe" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See any date in the Hebrew, Islamic, Chinese, Persian and other calendars, and count down to it every year."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh jedes Datum im hebräischen, islamischen, chinesischen, persischen und weiteren Kalendern und zähle jedes Jahr darauf herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta cualquier fecha en los calendarios hebreo, islámico, chino, persa y otros, y haz una cuenta atrás cada año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez n’importe quelle date dans les calendriers hébraïque, musulman, chinois, persan et d’autres, et faites un compte à rebours chaque année."
          }
        }
      }
    },
    "whatsNew.theSunTabNowShows" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Sun tab now shows the Moon too: today's phase, a month of phases, moonrise and moonset, and the year's full moons."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sonnen-Tab zeigt jetzt auch den Mond: die heutige Phase, einen Monat voller Phasen, Mondauf- und -untergang und die Vollmonde des Jahres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pestaña del Sol ahora muestra también la Luna: la fase de hoy, un mes de fases, la salida y la puesta de la Luna y las lunas llenas del año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onglet Soleil montre aussi la Lune : la phase du jour, un mois de phases, le lever et le coucher de la Lune et les pleines lunes de l’année."
          }
        }
      }
    },
    "whatsNew.timeBetweenFindADate" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Between, Find a Date, Exact Age and Milestones take an optional time, down to the minute."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitspanne, Datum finden, Genaues Alter und Meilensteine nehmen auf Wunsch eine Uhrzeit, auf die Minute genau."
