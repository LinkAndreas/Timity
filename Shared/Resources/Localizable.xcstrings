    },
    "Your Birthday" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Geburtstag"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cumpleaños"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre anniversaire"
          }
        }
      }
    },
    "Your events are safe on this device and sync as soon as iCloud accepts them. An update to Timity usually fixes this; if it keeps happening, please send feedback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse sind auf diesem Gerät sicher und werden synchronisiert, sobald iCloud sie annimmt. Meist hilft ein Update von Timity; wenn es weiter passiert, schick uns bitte Feedback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos están a salvo en este dispositivo y se sincronizarán en cuanto iCloud los acepte. Normalmente una actualización de Timity lo soluciona; si sigue ocurriendo, envíanos tus comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements sont en sécurité sur cet appareil et se synchroniseront dès qu’iCloud les acceptera. Une mise à jour de Timity règle généralement le problème ; si cela continue, envoyez-nous votre avis."
          }
        }
      }
    },
    "Your events are safe on this device. Quit and reopen Timity to try again; if it keeps happening, please send feedback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse sind auf diesem Gerät sicher. Beende Timity und öffne es erneut, um es noch einmal zu versuchen; wenn es weiter passiert, schick uns bitte Feedback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos están a salvo en este dispositivo. Cierra Timity y vuelve a abrirlo para intentarlo de nuevo; si sigue ocurriendo, envíanos tus comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements sont en sécurité sur cet appareil. Quittez Timity puis rouvrez-le pour réessayer ; si cela continue, envoyez-nous votre avis."
          }
        }
      }
    },
    "Your events stay on this device. Turn sync back on at any time; events from both sides are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse bleiben auf diesem Gerät. Du kannst die Synchronisierung jederzeit wieder einschalten; Ereignisse von beiden Seiten bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos se quedan en este dispositivo. Vuelve a activar la sincronización cuando quieras; se conservan los eventos de ambos lados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements restent sur cet appareil. Réactivez la synchronisation quand vous voulez ; les évènements des deux côtés sont conservés."
          }
        }
      }
    },
    "Your events sync once this device is online again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse werden synchronisiert, sobald dieses Gerät wieder online ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos se sincronizarán cuando este dispositivo vuelva a estar en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements se synchroniseront dès que cet appareil sera de nouveau en ligne."
          }
        }
      }
    },
    "Your events sync with your iPhone, iPad and Apple Watch through your private iCloud account. Only you can see them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse werden über deinen privaten iCloud-Account mit iPhone, iPad und Apple Watch synchronisiert. Nur du kannst sie sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos se sincronizan con tu iPhone, iPad y Apple Watch a través de tu cuenta privada de iCloud. Solo tú puedes verlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements se synchronisent avec votre iPhone, iPad et Apple Watch via votre compte iCloud privé. Vous seul pouvez les voir."
          }
        }
      }
    },
    "Your exact age, next birthday and age on other planets." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein genaues Alter, der nächste Geburtstag und dein Alter auf anderen Planeten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu edad exacta, tu próximo cumpleaños y tu edad en otros planetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre âge exact, votre prochain anniversaire et votre âge sur d’autres planètes."
          }
        }
      }
    },
    "Your location couldn't be found. Check that you're connected and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort konnte nicht ermittelt werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha encontrado tu ubicación. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position est introuvable. Vérifiez votre connexion et réessayez."
          }
        }
      }
    },
    "Your next events and the days until them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine nächsten Ereignisse und die Tage bis dahin."
          }
