    "Weekends and nationwide public holidays don't count, and neither does the end date." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochenenden und bundesweite Feiertage zählen nicht mit, das Enddatum auch nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cuentan los fines de semana ni los festivos nacionales, ni tampoco la fecha final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les week-ends, les jours fériés nationaux et la date de fin ne comptent pas."
          }
        }
      }
    },
    "Counting starts on the next workday and skips weekends and nationwide public holidays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezählt wird ab dem nächsten Arbeitstag, ohne Wochenenden und bundesweite Feiertage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recuento empieza el siguiente día laborable y omite fines de semana y festivos nacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le décompte commence au prochain jour ouvré et exclut les week-ends et les jours fériés nationaux."
          }
        }
      }
    },
    "workdays" : {
