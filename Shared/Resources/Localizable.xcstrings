    "sync.yourEventsAreDeletedFrom" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse werden aus iCloud gelöscht und die Synchronisierung wird ausgeschaltet. Auf diesem Gerät bleiben sie erhalten. Auf deinen anderen Geräten entfernt Timity möglicherweise die Ereignisse, die es aus iCloud erhalten hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your events are deleted from iCloud and sync turns off. They stay on this device. On your other devices, Timity may remove the events it got from iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos se eliminan de iCloud y la sincronización se desactiva. Se quedan en este dispositivo. En tus otros dispositivos, Timity puede eliminar los eventos que recibió de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos événements sont supprimés d’iCloud et la synchronisation est désactivée. Ils restent sur cet appareil. Sur vos autres appareils, Timity peut supprimer les événements reçus d’iCloud."
          }
        }
      }
    },
    "sync.yourEventsAreSafeOn" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse sind auf diesem Gerät sicher. Beende Timity und öffne es erneut, um es noch einmal zu versuchen; wenn es weiter passiert, schick uns bitte Feedback."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your events are safe on this device. Quit and reopen Timity to try again; if it keeps happening, please send feedback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos están a salvo en este dispositivo. Cierra Timity y vuelve a abrirlo para intentarlo de nuevo; si sigue ocurriendo, envíanos tus comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos événements sont en sécurité sur cet appareil. Quittez Timity puis rouvrez-le pour réessayer ; si cela continue, envoyez-nous votre avis."
          }
        }
      }
    },
    "sync.yourEventsAreSafeOn2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
