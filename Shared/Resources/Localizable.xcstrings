        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva «Sincronizar con iCloud». Tus eventos se quedan en este dispositivo e iCloud conserva su copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactive « Synchroniser avec iCloud ». Tes événements restent sur cet appareil et iCloud garde sa copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva “Sincronizza con iCloud”. I tuoi eventi restano su questo dispositivo e iCloud conserva la sua copia."
          }
        },
        "ja" : {
