    "eventDetail.theCountStartsAgainFrom" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zählung beginnt ab jetzt neu. Deine bisherigen Serien bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The count starts again from now. Your previous streaks are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta empieza de nuevo desde ahora. Tus rachas anteriores se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte repart de maintenant. Tes séries précédentes sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il conteggio riparte da adesso. Le tue serie precedenti vengono conservate."
