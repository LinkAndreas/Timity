    "One month after 31 January is the last day of February." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Monat nach dem 31. Januar ist der letzte Tag im Februar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mes después del 31 de enero es el último día de febrero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mois après le 31 janvier, c’est le dernier jour de février."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mese dopo il 31 gennaio è l’ultimo giorno di febbraio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1月31日の1か月後は2月の末日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1월 31일의 한 달 후는 2월의 마지막 날이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén maand na 31 januari is de laatste dag van februari."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um mês depois de 31 de janeiro é o último dia de fevereiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через месяц после 31 января — последний день февраля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 月 31 日之后一个月是 2 月的最后一天。"
          }
        }
      }
    },
    "Only needed when your devices keep showing different events. Each asks before it changes anything." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur nötig, wenn deine Geräte dauerhaft unterschiedliche Ereignisse zeigen. Jede Aktion fragt nach, bevor sie etwas ändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo es necesario si tus dispositivos siguen mostrando eventos distintos. Cada opción te pregunta antes de cambiar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile seulement si tes appareils affichent toujours des événements différents. Chaque option demande confirmation avant de modifier quoi que ce soit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve solo se i tuoi dispositivi continuano a mostrare eventi diversi. Ogni azione chiede conferma prima di modificare qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスごとに表示されるイベントが違う状態が続く場合にのみ必要です。どの操作も、変更する前に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기마다 계속 다른 이벤트가 표시될 때만 필요해요. 각 단계는 변경하기 전에 확인을 요청해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen nodig als je apparaten steeds verschillende gebeurtenissen tonen. Elke stap vraagt eerst toestemming voordat er iets verandert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só é necessário quando os seus dispositivos continuam mostrando eventos diferentes. Cada opção pergunta antes de alterar algo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, только если на твоих устройствах по-прежнему разные события. Перед любыми изменениями каждое устройство спросит тебя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你的设备持续显示不同事件时才需要。每台设备在做出任何更改前都会询问。"
          }
        }
      }
    },
