    "versionHistory.4_9_67.note4" : {
      "comment" : "Release note 4 of Timity 4.9.67, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonne und Mond: Goldene Stunde, Mondphasen, Mondauf- und -untergang, überall auf der Welt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun and moon: golden hour, moon phases, moonrise and moonset, anywhere in the world."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol y luna: hora dorada, fases lunares, salida y puesta de la luna, en cualquier lugar del mundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soleil et lune : heure dorée, phases de la lune, lever et coucher de la lune, partout dans le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sole e luna: ora d’oro, fasi lunari, sorgere e tramonto della luna, ovunque nel mondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太陽と月：世界中どこでも、ゴールデンアワー、月の満ち欠け、月の出と月の入りがわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해와 달: 전 세계 어디서나 골든 아워, 달의 위상, 월출 및 월몰."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zon en maan: gouden uur, maanfasen, maanopkomst en maanondergang, overal ter wereld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol e lua: hora dourada, fases da lua, nascer e pôr da lua, em qualquer lugar do mundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Солнце и Луна: золотой час, фазы Луны, восход и заход Луны в любой точке мира."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太阳和月亮：黄金时刻、月相、月出和月落，世界各地都能查看。"
          }
        }
      }
    },
    "versionHistory.4_9_67.note5" : {
      "comment" : "Release note 5 of Timity 4.9.67, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
