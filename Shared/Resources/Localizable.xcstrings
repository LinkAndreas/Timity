    "whatsNew.keepEveryEventAsA" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep every event as a backup or a spreadsheet, and bring them back any time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre alle Ereignisse als Backup oder Tabelle auf und hol sie jederzeit zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todos tus eventos como copia o como hoja de cálculo y recupéralos cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez tous vos événements en sauvegarde ou en feuille de calcul, et récupérez-les à tout moment."
          }
        }
      }
    },
    "whatsNew.newWidgets" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New Widgets"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
