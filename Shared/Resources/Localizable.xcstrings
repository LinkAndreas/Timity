    "tips.swipeRightOnAnEvent" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right on an event to pin it. Pinned events come first, as large cards."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische ein Ereignis nach rechts, um es anzuheften. Angeheftete Ereignisse stehen als große Karten ganz oben."
          }
        },
        "es" : {
          "stringUnit" : {
