          }
        }
      }
    },
    "Thanks for your support! Tap a colour to tint Timity with it, or pick one for any event." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke für deine Unterstützung! Tippe auf eine Farbe, um Timity damit einzufärben, oder wähle sie für ein Ereignis."
