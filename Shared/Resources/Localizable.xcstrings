    "sync.theEventsInICloudAre" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ereignisse in iCloud werden durch die auf diesem Gerät ersetzt, und deine anderen Geräte erhalten sie von dort. Änderungen, die nur deine anderen Geräte haben, gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The events in iCloud are replaced with the ones on this device, and your other devices get them from there. Changes only your other devices have are lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos de iCloud se sustituyen por los de este dispositivo, y tus otros dispositivos los reciben desde allí. Se pierden los cambios que solo tengan tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements d’iCloud sont remplacés par ceux de cet appareil, et tes autres appareils les reçoivent depuis iCloud. Les modifications présentes uniquement sur tes autres appareils sont perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi su iCloud vengono sostituiti con quelli di questo dispositivo, e gli altri tuoi dispositivi li ricevono da lì. Le modifiche presenti solo sugli altri dispositivi vanno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudのイベントがこのデバイスのイベントに置き換えられ、ほかのデバイスはそこからイベントを取得します。ほかのデバイスにしかない変更は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud의 이벤트가 이 기기의 이벤트로 대치되며, 다른 기기는 iCloud에서 이벤트를 받아요. 다른 기기에만 있는 변경 사항은 사라져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gebeurtenissen in iCloud worden vervangen door die op dit apparaat, en je andere apparaten krijgen ze daarvandaan. Wijzigingen die alleen op je andere apparaten staan, gaan verloren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os eventos do iCloud são substituídos pelos deste dispositivo, e os seus outros dispositivos os recebem de lá. As alterações que só os seus outros dispositivos têm são perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "События в iCloud будут заменены событиями с этого устройства, и другие устройства получат их оттуда. Изменения, которые есть только на других устройствах, будут потеряны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 中的事件将被此设备上的事件替换，你的其他设备会从 iCloud 获取它们。仅存在于其他设备上的更改将会丢失。"
          }
        }
      }
    },
    "sync.theEventsOnThisDevice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ereignisse auf diesem Gerät werden entfernt und erneut aus iCloud geladen. Noch nicht synchronisierte Änderungen gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The events on this device are removed and downloaded again from iCloud. Changes that haven't synced yet are lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos de este dispositivo se eliminan y se descargan de nuevo de iCloud. Se pierden los cambios que aún no se hayan sincronizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements de cet appareil sont supprimés puis retéléchargés depuis iCloud. Les modifications pas encore synchronisées sont perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi su questo dispositivo vengono rimossi e scaricati di nuovo da iCloud. Le modifiche non ancora sincronizzate vanno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのイベントが削除され、iCloudから再ダウンロードされます。まだ同期されていない変更は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 이벤트가 제거되고 iCloud에서 다시 다운로드돼요. 아직 동기화되지 않은 변경 사항은 사라져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gebeurtenissen op dit apparaat worden verwijderd en opnieuw uit iCloud gedownload. Wijzigingen die nog niet gesynchroniseerd zijn, gaan verloren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os eventos deste dispositivo são removidos e baixados novamente do iCloud. As alterações ainda não sincronizadas são perdidas."
          }
