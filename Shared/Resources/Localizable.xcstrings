    "sync.replaceTheEventsInICloud" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt die Ereignisse in iCloud durch die dieses Geräts. Nutze das, wenn dieses Gerät die richtigen Ereignisse hat; deine anderen Geräte folgen dann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace the events in iCloud with the ones on this device. Use this when this device has the right events; your other devices then follow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye los eventos de iCloud por los de este dispositivo. Úsalo cuando este dispositivo tenga los eventos correctos; tus otros dispositivos se actualizarán después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace les événements d’iCloud par ceux de cet appareil. À utiliser quand cet appareil a les bons événements ; tes autres appareils suivront."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci gli eventi su iCloud con quelli di questo dispositivo. Usa questa opzione quando questo dispositivo ha gli eventi giusti; gli altri dispositivi poi si adeguano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudのイベントを、このデバイスのイベントに置き換えます。このデバイスのイベントが正しい場合に使用してください。ほかのデバイスもそれに合わせて更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud의 이벤트를 이 기기의 이벤트로 대치해요. 이 기기에 올바른 이벤트가 있을 때 사용하세요. 그러면 다른 기기도 이를 따라요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervang de gebeurtenissen in iCloud door die op dit apparaat. Gebruik dit als dit apparaat de juiste gebeurtenissen heeft; je andere apparaten volgen dan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitua os eventos do iCloud pelos deste dispositivo. Use esta opção quando este dispositivo tiver os eventos corretos; os seus outros dispositivos acompanharão em seguida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменить события в iCloud событиями с этого устройства. Используй это, если на этом устройстве правильные события; другие устройства затем подстроятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用此设备上的事件替换 iCloud 中的事件。当此设备上的事件正确时使用；你的其他设备随后会跟着更新。"
          }
        }
      }
    },
