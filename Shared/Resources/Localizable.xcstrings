    "On your iPhone, open Settings, tap your name, then iCloud, and check that Timity may use iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf deinem iPhone die Einstellungen, tippe auf deinen Namen und dann auf iCloud und prüfe, ob Timity iCloud verwenden darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu iPhone, abre Ajustes, toca tu nombre y luego iCloud, y comprueba que Timity puede usar iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre iPhone, ouvrez Réglages, touchez votre nom, puis iCloud, et vérifiez que Timity peut utiliser iCloud."
          }
        }
      }
    },
