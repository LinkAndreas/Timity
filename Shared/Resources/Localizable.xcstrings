        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos se sincronizan con tu iPhone, iPad, Mac y Apple Watch a través de tu cuenta privada de iCloud. Solo tú puedes verlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes événements se synchronisent avec ton iPhone, iPad, Mac et Apple Watch via ton compte iCloud privé. Personne d’autre que toi ne peut les voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi eventi si sincronizzano con iPhone, iPad, Mac e Apple Watch tramite il tuo account iCloud privato. Solo tu puoi vederli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントはプライベートなiCloudアカウントを通じて、iPhone、iPad、Mac、Apple Watchの間で同期されます。イベントを見られるのはあなただけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트는 비공개 iCloud 계정을 통해 iPhone, iPad, Mac 및 Apple Watch 간에 동기화돼요. 나만 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gebeurtenissen worden via je privé-iCloud-account gesynchroniseerd met je iPhone, iPad, Mac en Apple Watch. Alleen jij kunt ze zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus eventos são sincronizados com o seu iPhone, iPad, Mac e Apple Watch pela sua conta privada do iCloud. Só você pode vê-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои события синхронизируются между iPhone, iPad, Mac и Apple Watch через твой личный аккаунт iCloud. Видишь их только ты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的事件通过你的私人 iCloud 账户在 iPhone、iPad、Mac 和 Apple Watch 之间同步。只有你能看到它们。"
