    "sync.waitAMinuteCopiesOf" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte eine Minute: Kopien desselben Ereignisses von zwei Geräten werden zusammengeführt, sobald beide synchronisiert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait a minute: copies of the same event made on two devices merge once both have synced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera un minuto: las copias del mismo evento creadas en dos dispositivos se combinan cuando ambos se han sincronizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patiente une minute : les copies d’un même événement créées sur deux appareils fusionnent une fois les deux synchronisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta un minuto: le copie dello stesso evento create su due dispositivi si uniscono quando entrambi si sono sincronizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1分ほどお待ちください。2台のデバイスで作成した同じイベントは、両方の同期が完了すると統合されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠시 기다리세요. 두 기기에서 만든 같은 이벤트의 사본은 두 기기가 모두 동기화되면 병합돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht een minuut: kopieën van dezelfde gebeurtenis die op twee apparaten zijn gemaakt, worden samengevoegd zodra beide gesynchroniseerd zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde um minuto: cópias do mesmo evento criadas em dois dispositivos se mesclam depois que ambos sincronizarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подожди минуту: копии одного и того же события, созданные на двух устройствах, объединятся, когда оба синхронизируются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请稍等片刻：在两台设备上创建的同一事件的副本，会在两台设备都同步后合并。"
          }
        }
      }
    },
