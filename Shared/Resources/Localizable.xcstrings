    "sync.freeUpSpaceOrAdd" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Speicher frei oder erweitere deinen iCloud-Speicher, um wieder zu synchronisieren. Bis dahin bleiben deine Ereignisse auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free up space or add iCloud storage to sync again. Your events stay on this device meanwhile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera espacio o amplía tu almacenamiento de iCloud para volver a sincronizar. Mientras tanto, tus eventos se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
