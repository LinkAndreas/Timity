    "sync.yourEventsStayOnThis" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse bleiben auf diesem Gerät. Du kannst die Synchronisierung jederzeit wieder einschalten; die Ereignisse auf diesem Gerät und in iCloud bleiben dann beide erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your events stay on this device. Turn sync back on at any time; events from both sides are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos se quedan en este dispositivo. Vuelve a activar la sincronización cuando quieras; se conservarán tanto los de este dispositivo como los de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes événements restent sur cet appareil. Réactive la synchronisation quand tu veux ; ceux de cet appareil et ceux d’iCloud seront alors conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi eventi restano su questo dispositivo. Puoi riattivare la sincronizzazione in qualsiasi momento; gli eventi di entrambe le parti verranno conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントはこのデバイスに残ります。同期はいつでもオンに戻せます。両方のイベントが保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트는 이 기기에 유지돼요. 언제든지 동기화를 다시 켤 수 있으며, 양쪽의 이벤트가 모두 유지돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gebeurtenissen blijven op dit apparaat. Zet synchronisatie op elk moment weer aan; de gebeurtenissen van beide kanten blijven bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus eventos permanecem neste dispositivo. Reative a sincronização a qualquer momento; os eventos dos dois lados são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои события останутся на этом устройстве. Синхронизацию можно снова включить в любой момент — события с обеих сторон сохранятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的事件会保留在此设备上。你随时可以重新打开同步；两边的事件都会保留。"
          }
        }
      }
    },
