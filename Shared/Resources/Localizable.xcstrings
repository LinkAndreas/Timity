        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos se sincronizarán cuando este dispositivo vuelva a estar en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements se synchroniseront dès que cet appareil sera de nouveau en ligne."
          }
        }
      }
    },
    "Syncing can pause without a connection or in Low Power Mode. Open Timity and give it a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Verbindung oder im Stromsparmodus kann die Synchronisierung pausieren. Öffne Timity und warte einen Moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización puede pausarse sin conexión o en modo de bajo consumo. Abre Timity y espera un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation peut s’interrompre sans connexion ou en mode économie d’énergie. Ouvrez Timity et patientez un instant."
          }
        }
      }
    },
