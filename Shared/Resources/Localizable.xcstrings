    "sync.yourEventsAreDeletedFrom" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your events are deleted from iCloud and sync turns off. They stay on this device. On your other devices, Timity may remove the events it got from iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse werden aus iCloud gelöscht und die Synchronisierung wird ausgeschaltet. Auf diesem Gerät bleiben sie erhalten. Auf deinen anderen Geräten entfernt Timity möglicherweise die Ereignisse, die es aus iCloud erhalten hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos se eliminan de iCloud y la sincronización se desactiva. Se quedan en este dispositivo. En tus otros dispositivos, Timity puede eliminar los eventos que recibió de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements sont supprimés d’iCloud et la synchronisation est désactivée. Ils restent sur cet appareil. Sur vos autres appareils, Timity peut supprimer les évènements reçus d’iCloud."
          }
        }
      }
    },
    "sync.yourEventsAreSafeOn" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your events are safe on this device. Quit and reopen Timity to try again; if it keeps happening, please send feedback."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse sind auf diesem Gerät sicher. Beende Timity und öffne es erneut, um es noch einmal zu versuchen; wenn es weiter passiert, schick uns bitte Feedback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos están a salvo en este dispositivo. Cierra Timity y vuelve a abrirlo para intentarlo de nuevo; si sigue ocurriendo, envíanos tus comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements sont en sécurité sur cet appareil. Quittez Timity puis rouvrez-le pour réessayer ; si cela continue, envoyez-nous votre avis."
          }
        }
      }
    },
    "sync.yourEventsAreSafeOn2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your events are safe on this device and sync as soon as iCloud accepts them. An update to Timity usually fixes this; if it keeps happening, please send feedback."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse sind auf diesem Gerät sicher und werden synchronisiert, sobald iCloud sie annimmt. Meist hilft ein Update von Timity; wenn es weiter passiert, schick uns bitte Feedback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos están a salvo en este dispositivo y se sincronizarán en cuanto iCloud los acepte. Normalmente una actualización de Timity lo soluciona; si sigue ocurriendo, envíanos tus comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements sont en sécurité sur cet appareil et se synchroniseront dès qu’iCloud les acceptera. Une mise à jour de Timity règle généralement le problème ; si cela continue, envoyez-nous votre avis."
          }
        }
      }
    },
    "sync.yourEventsOnThisDevice" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your events on this device are kept safe while this runs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse auf diesem Gerät bleiben dabei sicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos de este dispositivo se mantienen a salvo mientras tanto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements sur cet appareil restent en sécurité pendant l’opération."
          }
        }
      }
    },
    "sync.yourEventsStayOnThis" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your events stay on this device. Turn sync back on at any time; events from both sides are kept."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse bleiben auf diesem Gerät. Du kannst die Synchronisierung jederzeit wieder einschalten; Ereignisse von beiden Seiten bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos se quedan en este dispositivo. Vuelve a activar la sincronización cuando quieras; se conservan los eventos de ambos lados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos évènements restent sur cet appareil. Réactivez la synchronisation quand vous voulez ; les évènements des deux côtés sont conservés."
          }
        }
      }
    },
    "sync.yourEventsSyncOnceThis" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your events sync once this device is online again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse werden synchronisiert, sobald dieses Gerät wieder online ist."
