    "Use the same Apple Account on all your devices." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende auf allen Geräten denselben Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la misma cuenta de Apple en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le même compte Apple sur tous tes appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa lo stesso Account Apple su tutti i tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスで同じApple Accountを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 기기에서 같은 Apple 계정을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik hetzelfde Apple Account op al je apparaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a mesma Conta Apple em todos os seus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используй один и тот же Аккаунт Apple на всех своих устройствах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的所有设备上使用同一个 Apple 账户。"
          }
        }
      }
    },
    "versionHistory.0_1.note1" : {
      "comment" : "Release note 1 of Timity 0.1, summing up the first release, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity erscheint im App Store: Sieh, wie viel Zeit bis zu einem Ereignis bleibt oder wie viel seitdem vergangen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity arrives on the App Store: see how much time is left until an event ahead, or how much has passed since one behind you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity llega al App Store: mira cuánto falta para un evento o cuánto tiempo ha pasado desde él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity arrive sur l’App Store : vois combien de temps il reste avant un événement, ou combien s’est écoulé depuis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity arriva su App Store: scopri quanto tempo manca a un evento futuro o quanto ne è passato da uno ormai alle spalle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TimityがApp Storeに登場。これから来るイベントまでの残り時間や、過ぎたイベントからの経過時間がわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity가 App Store에 출시되었어요. 다가오는 이벤트까지 남은 시간이나 지난 이벤트 이후 흐른 시간을 확인할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity verschijnt in de App Store: zie hoeveel tijd er nog is tot een komende gebeurtenis, of hoeveel er is verstreken sinds een gebeurtenis achter je."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Timity chega à App Store: veja quanto tempo falta para um evento futuro, ou quanto tempo passou desde um evento passado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity появляется в App Store: смотри, сколько времени осталось до предстоящего события или сколько прошло с прошедшего."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity 登陆 App Store：查看距离即将到来的事件还有多少时间，或距离已过去的事件过了多久。"
          }
        }
      }
    },
    "versionHistory.0_1.note2" : {
      "comment" : "Release note 2 of Timity 0.1, summing up the first release, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechne die Zeit zwischen zwei Daten und addiere oder subtrahiere Jahre, Monate, Wochen, Tage, Stunden und Minuten zu einem beliebigen Datum – etwa, um zu sehen, wann ein 167 Minuten langer Film endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Work out the time between two dates, and add or subtract years, months, weeks, days, hours and minutes to or from any date — say, to see when a 167-minute film ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcula el tiempo entre dos fechas y suma o resta años, meses, semanas, días, horas y minutos a cualquier fecha, por ejemplo para saber cuándo termina una película de 167 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcule la durée entre deux dates, et ajoute ou soustrais des années, mois, semaines, jours, heures et minutes à n’importe quelle date, par exemple pour savoir quand se termine un film de 167 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcola il tempo tra due date e aggiungi o sottrai anni, mesi, settimane, giorni, ore e minuti a qualsiasi data, ad esempio per sapere quando finisce un film di 167 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つの日付の間の期間を計算したり、任意の日付に年、月、週、日、時間、分を加算・減算したりできます。たとえば167分の映画が何時に終わるかもわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 날짜 사이의 기간을 계산하고, 원하는 날짜에 연, 월, 주, 일, 시간, 분을 더하거나 뺄 수 있어요. 예를 들어 167분짜리 영화가 언제 끝나는지 알 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereken de tijd tussen twee datums, en tel jaren, maanden, weken, dagen, uren en minuten op bij of af van een datum – bijvoorbeeld om te zien wanneer een film van 167 minuten afloopt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcule o tempo entre duas datas e some ou subtraia anos, meses, semanas, dias, horas e minutos de qualquer data — por exemplo, para saber quando termina um filme de 167 minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вычисляй время между двумя датами, прибавляй к любой дате или вычитай из неё годы, месяцы, недели, дни, часы и минуты — например, чтобы узнать, когда закончится фильм длиной 167 минут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计算两个日期之间的时间，或为任意日期加减年、月、周、天、小时和分钟，例如看看一部 167 分钟的电影何时结束。"
          }
        }
      }
    },
    "versionHistory.0_1.note3" : {
