    "Week Numbers" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderwochen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numéros de semaine"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Números de semana"
          }
        }
      }
    },
    "Week numbers follow your region's calendar, which decides the first day of the week and the first week of the year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderwochen folgen dem Kalender deiner Region, der den ersten Wochentag und die erste Woche des Jahres festlegt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros de semaine suivent le calendrier de votre région, qui fixe le premier jour de la semaine et la première semaine de l’année."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números de semana siguen el calendario de tu región, que fija el primer día de la semana y la primera semana del año."
          }
        }
      }
    },
    "Week of a Date" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woche eines Datums"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semaine d’une date"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semana de una fecha"
          }
        }
      }
    },
    "Weekend Days" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochenendtage"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jours de week-end"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Días de fin de semana"
          }
        }
      }
    },
    "Weekends follow your region's calendar. Only nationwide public holidays are left out, not regional ones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochenenden folgen dem Kalender deiner Region. Nur bundesweite Feiertage werden ausgelassen, keine regionalen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les week-ends suivent le calendrier de votre région. Seuls les jours fériés nationaux sont exclus, pas les régionaux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fines de semana siguen el calendario de tu región. Solo se excluyen los festivos nacionales, no los regionales."
          }
        }
      }
    },
    "Weeks in %@" : {
      "localizations" : {
