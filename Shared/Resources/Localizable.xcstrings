    },
    "Your purchase is waiting for approval. It will complete automatically once approved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf wartet auf Bestätigung. Er wird automatisch abgeschlossen, sobald er genehmigt ist."
          }
        },
        "es" : {
          "stringUnit" : {
