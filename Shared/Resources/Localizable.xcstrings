    "whatsNew.daysHoursAndYearsInTheRightForm" : {
      "comment" : "What's New: the text under “Correct Plurals”, a feature of Timity 4.11. The example is how 1.5 years reads in this language, as in the Age calculator's ages on other planets.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tage, Stunden und Jahre in jeder Sprache in der richtigen Form, auch „1,5 Jahre“ auf anderen Planeten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Days, hours and years in the right form in every language, even “1.5 years” on other planets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Días, horas y años en la forma correcta en todos los idiomas, incluso «1,5 años» en otros planetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jours, heures et années bien accordés dans chaque langue, même « 1,5 an » sur d’autres planètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giorni, ore e anni nella forma giusta in ogni lingua, anche “1,5 anni” su altri pianeti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日、時間、年がすべての言語で正しく表記されます。ほかの惑星での「1.5年」も同様です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 언어에서 일, 시간, 연이 올바르게 표시돼요. 다른 행성에서의 ‘1.5년’도요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagen, uren en jaren in elke taal in de juiste vorm, zelfs ‘1,5 jaar’ op andere planeten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dias, horas e anos na forma certa em todos os idiomas, até “1,5 ano” em outros planetas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дни, часы и годы в правильной форме на каждом языке: 1 день, 3 дня, 5 дней — и даже «1,5 года» на других планетах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天、小时和年在每种语言中都以正确的形式显示，包括其他行星上的“1.5 年”。"
          }
        }
      }
    },
