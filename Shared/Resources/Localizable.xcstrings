    "Your Sleep" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Schlaf"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sueño"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre sommeil"
          }
        }
      }
    },
    "Sleep comes in cycles of about 90 minutes, a little shorter or longer for some people. Waking between them feels easier. Most adults need 7 to 9 hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf verläuft in Zyklen von etwa 90 Minuten, bei manchen etwas kürzer oder länger. Zwischen zwei Zyklen aufzuwachen fällt leichter. Die meisten Erwachsenen brauchen 7 bis 9 Stunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño va en ciclos de unos 90 minutos, algo más cortos o largos para algunas personas. Despertar entre ellos resulta más fácil. La mayoría de los adultos necesita de 7 a 9 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil se déroule en cycles d’environ 90 minutes, un peu plus courts ou plus longs selon les personnes. Se réveiller entre deux cycles est plus facile. La plupart des adultes ont besoin de 7 à 9 heures."
          }
        }
      }
    },
    "for %@ of sleep · %lld cycles" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "für %1$@ Schlaf · %2$lld Zyklen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "para %1$@ de sueño · %2$lld ciclos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pour %1$@ de sommeil · %2$lld cycles"
          }
        }
      }
    },
