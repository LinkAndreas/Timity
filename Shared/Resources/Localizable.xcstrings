    "Still stuck? Turn Sync with iCloud off and on again. Your events stay on this device." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt es noch? Schalte „Mit iCloud synchronisieren“ aus und wieder ein. Deine Ereignisse bleiben auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sigue sin funcionar? Desactiva y vuelve a activar «Sincronizar con iCloud». Tus eventos se quedan en este dispositivo."
          }
        },
        "fr" : {
