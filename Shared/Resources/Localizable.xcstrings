    "astronomy.allowTimityToUseYour" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Timity in den Einstellungen, deinen Standort zu verwenden, um Sonnenauf- und -untergang für deinen Ort zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Timity to use your location in Settings to see sunrise and sunset where you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a Timity usar tu ubicación en Ajustes para ver el amanecer y el atardecer donde estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Timity à utiliser votre position dans Réglages pour voir le lever et le coucher du soleil là où vous êtes."
          }
        }
      }
    },
    "astronomy.allowTimityToUseYour.mac" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Timity to use your location in System Settings › Privacy & Security › Location Services to see sunrise and sunset where you are."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Timity in den Systemeinstellungen unter „Datenschutz & Sicherheit“ › „Ortungsdienste“, deinen Standort zu verwenden, um Sonnenauf- und -untergang für deinen Ort zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a Timity usar tu ubicación en Ajustes del Sistema › Privacidad y seguridad › Localización para ver el amanecer y el atardecer donde estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Timity à utiliser votre position dans Réglages Système › Confidentialité et sécurité › Service de localisation pour voir le lever et le coucher du soleil là où vous êtes."
          }
        }
      }
    },
