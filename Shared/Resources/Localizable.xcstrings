    "Each break joins public holidays and weekends with as few days of leave as possible. Only nationwide holidays count." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Pause verbindet Feiertage und Wochenenden mit so wenigen Urlaubstagen wie möglich. Es zählen nur bundesweite Feiertage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pausa une festivos y fines de semana con los menos días de vacaciones posibles. Solo cuentan los festivos nacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque pause relie jours fériés et week-ends avec le moins de congés possible. Seuls les jours fériés nationaux comptent."
          }
        }
      }
    },
