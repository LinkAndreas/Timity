            "value" : "Compter"
          }
        }
      }
    },
    "Count down to birthdays, trips and deadlines — and see how long since the moments that matter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähle bis zu Geburtstagen, Reisen und Fristen herunter – und sieh, wie lange die wichtigen Momente her sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta atrás hasta cumpleaños, viajes y plazos, y mira cuánto hace de los momentos que importan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez les jours jusqu’aux anniversaires, voyages et échéances – et voyez depuis combien de temps les moments importants ont eu lieu."
          }
        }
      }
    },
    "Count down to birthdays, trips and deadlines — and see how long since the moments that matter. Your events sync through iCloud to your iPhone, iPad and Apple Watch." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähle bis zu Geburtstagen, Reisen und Fristen – und sieh, wie lange die wichtigen Momente her sind. Deine Ereignisse werden über iCloud mit iPhone, iPad und Apple Watch synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta hasta cumpleaños, viajes y plazos, y mira cuánto ha pasado desde los momentos importantes. Tus eventos se sincronizan por iCloud con tu iPhone, iPad y Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez jusqu’aux anniversaires, voyages et échéances — et voyez depuis quand ont eu lieu les moments qui comptent. Vos évènements se synchronisent via iCloud sur votre iPhone, iPad et Apple Watch."
          }
        }
      }
    },
    "Count the Last Day" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzten Tag mitzählen"
