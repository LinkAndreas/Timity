    "calc.bridgeDays.eachBreakJoinsPublicHolidays" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Vorschlag verbindet Feiertage und Wochenenden mit möglichst wenigen Urlaubstagen. Es zählen nur bundesweite Feiertage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each break joins public holidays and weekends with as few days of leave as possible. Only nationwide holidays count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada puente une festivos y fines de semana con el menor número posible de días de vacaciones. Solo cuentan los festivos nacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque pont relie jours fériés et week-ends avec le moins de jours de congé possible. Seuls les jours fériés nationaux comptent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni ponte unisce festività e fine settimana con il minor numero possibile di giorni di ferie. Contano solo le festività nazionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各連休は、できるだけ少ない休暇日数で祝日と週末をつなげたものです。全国共通の祝日のみが対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 연휴는 공휴일과 주말을 최소한의 휴가로 연결해요. 전국 공휴일만 포함돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke periode verbindt feestdagen en weekenden met zo weinig mogelijk verlofdagen. Alleen landelijke feestdagen tellen mee."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada emenda une feriados e fins de semana com o mínimo possível de dias de férias. Só contam os feriados nacionais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый вариант объединяет праздники и выходные так, чтобы потратить как можно меньше дней отпуска. Учитываются только общегосударственные праздники."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每段假期都用尽可能少的年假天数把公共假日和周末连起来。仅计算全国性假日。"
          }
        }
      }
    },
