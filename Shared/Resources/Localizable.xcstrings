    "settings.aBackupKeepsEveryDetail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Backup enthält alle Details und lässt sich wieder in Timity öffnen. Eine Tabelle öffnet sich in Numbers oder Excel. Beim Import kommen neue Ereignisse hinzu und geänderte werden aktualisiert; dieselbe Datei zweimal zu importieren ändert nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup keeps every detail and opens in Timity again. A spreadsheet opens in Numbers or Excel. Importing adds new events and updates changed ones; importing the same file twice changes nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia guarda todos los detalles y se vuelve a abrir en Timity. Una hoja de cálculo se abre en Numbers o Excel. Al importar se añaden los eventos nuevos y se actualizan los cambiados; importar el mismo archivo dos veces no cambia nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde conserve tous les détails et se rouvre dans Timity. Une feuille de calcul s’ouvre dans Numbers ou Excel. L’importation ajoute les nouveaux événements et met à jour ceux qui ont changé ; importer deux fois le même fichier ne change rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un backup conserva ogni dettaglio e si riapre in Timity. Un foglio di calcolo si apre in Numbers o Excel. L’importazione aggiunge i nuovi eventi e aggiorna quelli modificati; importare due volte lo stesso file non cambia nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップにはすべての詳細が保存され、Timityで再び開けます。スプレッドシートはNumbersやExcelで開けます。読み込むと新しいイベントが追加され、変更されたイベントが更新されます。同じファイルを2回読み込んでも何も変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 모든 세부사항을 보존하며 Timity에서 다시 열 수 있어요. 스프레드시트는 Numbers 또는 Excel에서 열려요. 가져오기를 하면 새로운 이벤트가 추가되고 변경된 이벤트가 업데이트되며, 같은 파일을 두 번 가져와도 아무것도 바뀌지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een reservekopie bewaart elk detail en opent weer in Timity. Een spreadsheet opent in Numbers of Excel. Importeren voegt nieuwe gebeurtenissen toe en werkt gewijzigde bij; hetzelfde bestand twee keer importeren verandert niets."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um backup guarda todos os detalhes e abre novamente no Timity. Uma planilha abre no Numbers ou no Excel. A importação adiciona eventos novos e atualiza os alterados; importar o mesmo arquivo duas vezes não muda nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервная копия сохраняет все детали и снова открывается в Timity. Таблица открывается в Numbers или Excel. При импорте добавляются новые события и обновляются изменённые; повторный импорт того же файла ничего не меняет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份会保留所有细节，并可再次在 Timity 中打开。电子表格可在 Numbers 或 Excel 中打开。导入会添加新事件并更新已更改的事件；同一文件导入两次不会有任何变化。"
          }
        }
      }
    },
