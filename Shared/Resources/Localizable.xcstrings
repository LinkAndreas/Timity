    },
    "Thanks for your support! Pick an icon for your Home Screen — Timity takes on its colour." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke für deine Unterstützung! Wähle ein Icon für deinen Home-Bildschirm – Timity übernimmt seine Farbe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci pour votre soutien ! Choisissez une icône pour votre écran d’accueil — Timity adopte sa couleur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Gracias por tu apoyo! Elige un icono para tu pantalla de inicio: Timity adopta su color."
          }
        }
      }
    },
    "The count starts again from now. Your previous streaks are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zählung beginnt ab jetzt neu. Deine bisherigen Serien bleiben erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte repart de maintenant. Vos séries précédentes sont conservées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta empieza de nuevo desde ahora. Tus rachas anteriores se conservan."
          }
        }
      }
    },
    "The event couldn't be found." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ereignis wurde nicht gefunden."
