    "versionHistory.4_9_67.note8" : {
      "comment" : "Release note 8 of Timity 4.9.67, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederkehrende Ereignisse: Intervalle, Wochentage, letzter Werktag und weitere Kalender."
