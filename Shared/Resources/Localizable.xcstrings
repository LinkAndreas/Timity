    "settings.whenTimityCrashesOrFreezes" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Timity crashes or freezes, iOS gives it a technical report. With this on, Timity sends it to the developer through iCloud, without your name, your events or anything you entered, so the problem can be fixed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Timity abstürzt oder hängt, erhält es von iOS einen technischen Bericht. Ist dies an, sendet Timity ihn über iCloud an den Entwickler – ohne deinen Namen, deine Ereignisse oder sonstige Eingaben –, damit das Problem behoben werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando Timity se cierra o se bloquea, iOS le da un informe técnico. Con esta opción, Timity lo envía al desarrollador a través de iCloud, sin tu nombre, tus eventos ni nada de lo que hayas escrito, para que el problema se pueda corregir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand Timity plante ou se fige, iOS lui fournit un rapport technique. Avec cette option, Timity l’envoie au développeur via iCloud, sans votre nom, vos événements ni rien de ce que vous avez saisi, afin que le problème puisse être corrigé."
          }
        }
      }
    },
    "settings.withWeeksOn17Days" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With weeks on, 17 days read as 2 weeks and 3 days. Milestone alerts celebrate round numbers since your events, such as 10,000 days."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Wochen werden 17 Tage zu 2 Wochen und 3 Tagen. Meilenstein-Mitteilungen feiern runde Zahlen seit deinen Ereignissen, etwa 10.000 Tage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con semanas, 17 días se leen como 2 semanas y 3 días. Los avisos de hitos celebran números redondos desde tus eventos, como 10.000 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec les semaines, 17 jours deviennent 2 semaines et 3 jours. Les alertes d’étapes célèbrent les nombres ronds depuis vos évènements, comme 10 000 jours."
          }
        }
      }
    },
