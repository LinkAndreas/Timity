    "import.allowAccessInSettingsTo" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff in den Einstellungen, um Geburtstage und Termine in Timity zu übernehmen. Timity liest sie nur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow access in Settings to bring birthdays and events into Timity. Timity only reads them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso en Ajustes para traer cumpleaños y eventos a Timity. Timity solo los lee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorise l’accès dans Réglages pour importer anniversaires et événements dans Timity. Timity ne fait que les lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso in Impostazioni per portare compleanni ed eventi in Timity. Timity li legge soltanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誕生日やイベントをTimityに取り込むには、「設定」でアクセスを許可してください。Timityはデータを読み取るだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생일과 이벤트를 Timity로 가져오려면 설정에서 접근을 허용하세요. Timity는 읽기만 해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta toegang toe in Instellingen om verjaardagen en activiteiten naar Timity te halen. Timity leest ze alleen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso em Ajustes para trazer aniversários e eventos para o Timity. O Timity apenas os lê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разреши доступ в Настройках, чтобы перенести дни рождения и события в Timity. Timity только читает их."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中允许访问，即可将生日和事件导入 Timity。Timity 仅读取这些信息。"
          }
        }
      }
    },
