    "sync.turnOffSyncWithICloud" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte „Mit iCloud synchronisieren“ aus. Deine Ereignisse bleiben auf diesem Gerät, und iCloud behält seine Kopie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off Sync with iCloud. Your events stay on this device, and iCloud keeps its copy."
