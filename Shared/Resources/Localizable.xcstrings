      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist weder ein Timity-Backup noch ein Timity-Ereignis oder eine Tabelle mit den Spalten Title und Date."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file isn't a Timity backup, a Timity event or a spreadsheet with Title and Date columns."
