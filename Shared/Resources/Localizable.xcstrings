      }
    },
    "versionHistory.4_9_67.note6" : {
      "comment" : "Release note 6 of Timity 4.9.67, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Ereignis zeigt seinen Wochentag und bei Geburtstagen und Jahrestagen die genaue Zeit seit dem ersten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every event shows its weekday and, for birthdays and anniversaries, the exact time since the first one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada evento muestra su día de la semana y, en cumpleaños y aniversarios, el tiempo exacto desde el primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque événement affiche son jour de la semaine et, pour un anniversaire, le temps exact depuis le premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni evento mostra il suo giorno della settimana e, per compleanni e anniversari, il tempo esatto trascorso dal primo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのイベントに曜日が表示され、誕生日や記念日では最初の日からの正確な経過時間も表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 이벤트에 요일이 표시되며, 생일과 기념일에는 처음 그날 이후 정확히 얼마나 지났는지 표시돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke gebeurtenis toont de weekdag en, bij verjaardagen en jubilea, de exacte tijd sinds de allereerste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada evento mostra o dia da semana e, para aniversários e datas comemorativas, o tempo exato desde o primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое событие показывает день недели, а для дней рождения и годовщин — точное время с самого первого из них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个事件都会显示星期几；生日和纪念日还会显示自第一次以来的确切时间。"
          }
        }
      }
    },
    "versionHistory.4_9_67.note7" : {
