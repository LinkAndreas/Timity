        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timityはダークテーマで起動するようになりました。ライトテーマにしたい場合は「設定」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 Timity가 다크 테마로 시작돼요. 라이트 테마를 원하면 설정에서 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity start nu met een donker thema; liever een licht thema? Wijzig het in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Timity agora começa com um tema escuro; se preferir um claro, altere em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь Timity запускается с тёмной темой; если тебе больше нравится светлая, измени её в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity 现在默认使用深色主题；如果你喜欢浅色主题，可以在“设置”中更改。"
          }
        }
      }
    },
