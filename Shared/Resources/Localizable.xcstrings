    "calc.bridgeDays.eachBreakJoinsPublicHolidays" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Vorschlag verbindet Feiertage und Wochenenden mit möglichst wenigen Urlaubstagen. Es zählen nur bundesweite Feiertage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each break joins public holidays and weekends with as few days of leave as possible. Only nationwide holidays count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada puente une festivos y fines de semana con el menor número posible de días de vacaciones. Solo cuentan los festivos nacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque pont relie jours fériés et week-ends avec le moins de jours de congé possible. Seuls les jours fériés nationaux comptent."
          }
        }
      }
    },
