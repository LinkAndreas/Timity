    "astronomy.aBlueMoonIsThe" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A blue moon is the second full moon in one calendar month."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Blauer Mond ist der zweite Vollmond in einem Kalendermonat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una luna azul es la segunda luna llena de un mismo mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une lune bleue est la deuxième pleine lune d’un même mois."
          }
