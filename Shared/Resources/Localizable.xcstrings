    "common.yourEventsSyncWithYour" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse werden über deinen privaten iCloud-Account mit iPhone, iPad, Mac und Apple Watch synchronisiert. Nur du kannst sie sehen."
