    "calc.weekNumbers.weekNumbersFollowYourRegions" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderwochen richten sich nach dem Kalender deiner Region, der den ersten Wochentag und die erste Woche des Jahres festlegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Week numbers follow your region's calendar, which decides the first day of the week and the first week of the year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números de semana siguen el calendario de tu región, que fija el primer día de la semana y la primera semana del año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros de semaine suivent le calendrier de ta région, qui fixe le premier jour de la semaine et la première semaine de l’année."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I numeri delle settimane seguono il calendario della tua regione, che stabilisce il primo giorno della settimana e la prima settimana dell’anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週番号はお住まいの地域の暦に従います。地域によって週の始まりの曜日と年の第1週が決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주차는 사용자 지역의 달력을 따르며, 이 달력에 따라 한 주의 첫 요일과 한 해의 첫 주가 정해져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weeknummers volgen de kalender van je regio, die bepaalt wat de eerste dag van de week en de eerste week van het jaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os números das semanas seguem o calendário da sua região, que define o primeiro dia da semana e a primeira semana do ano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Номера недель зависят от календаря твоего региона: он определяет первый день недели и первую неделю года."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周数遵循你所在地区的日历，由它决定一周的第一天和一年的第一周。"
          }
        }
      }
    },
