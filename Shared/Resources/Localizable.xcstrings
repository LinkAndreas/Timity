    "Allow access in Settings to bring birthdays and events into Timity. Timity only reads them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff in den Einstellungen, um Geburtstage und Termine in Timity zu übernehmen. Timity liest sie nur."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès dans Réglages pour importer anniversaires et évènements dans Timity. Timity ne fait que les lire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso en Ajustes para traer cumpleaños y eventos a Timity. Timity solo los lee."
          }
        }
      }
    },
    "Allow Timity to use your location in Settings to see sunrise and sunset where you are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Timity in den Einstellungen, deinen Standort zu verwenden, um Sonnenauf- und -untergang für deinen Ort zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Timity à utiliser votre position dans Réglages pour voir le lever et le coucher du soleil là où vous êtes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a Timity usar tu ubicación en Ajustes para ver el amanecer y el atardecer donde estás."
          }
        }
      }
    },
    "Allow Timity to use your location in the Watch's Settings to see sunrise and sunset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Timity in den Einstellungen der Watch, deinen Standort zu verwenden, um Sonnenauf- und -untergang zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Timity à utiliser votre position dans les réglages de la Watch pour voir le lever et le coucher du soleil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a Timity usar tu ubicación en los ajustes del Watch para ver el amanecer y el atardecer."
          }
        }
      }
    },
    "An end earlier than the start is the next day, as for night shifts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ende vor dem Beginn liegt am nächsten Tag, wie bei Nachtschichten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fin plus tôt que le début tombe le lendemain, comme pour un travail de nuit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un final anterior al inicio es al día siguiente, como en los turnos de noche."
          }
        }
      }
    },
