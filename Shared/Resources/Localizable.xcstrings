    "sync.connectToWiFiTurn" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich mit dem WLAN, schalte den Stromsparmodus aus und lass Timity eine Minute geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to Wi‑Fi, turn off Low Power Mode, and keep Timity open for a minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate a una red Wi‑Fi, desactiva el modo de bajo consumo y deja Timity abierto un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi au Wi‑Fi, désactive le mode Économie d’énergie et laisse Timity ouvert une minute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettiti a una rete Wi‑Fi, disattiva la modalità Risparmio energetico e tieni Timity aperto per un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi‑Fiに接続し、低電力モードをオフにして、Timityを1分ほど開いたままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi‑Fi에 연결하고 저전력 모드를 끈 다음, Timity를 1분 정도 열어 두세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak verbinding met wifi, zet de energiebesparingsmodus uit en houd Timity een minuut open."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte-se a uma rede Wi‑Fi, desative o Modo Pouca Energia e mantenha o Timity aberto por um minuto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключись к Wi‑Fi, выключи Режим энергосбережения и оставь Timity открытым на минуту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接无线局域网，关闭低电量模式，并让 Timity 保持打开一分钟。"
          }
        }
      }
    },
    "sync.deleteAnyThatRemainIn" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
