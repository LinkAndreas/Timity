        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo no es una copia de Timity, un evento de Timity ni una hoja de cálculo con las columnas Title y Date."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier n’est ni une sauvegarde Timity, ni un événement Timity, ni une feuille de calcul avec les colonnes Title et Date."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file non è un backup di Timity, un evento di Timity o un foglio di calcolo con le colonne Title e Date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは、Timityのバックアップ、Timityのイベント、または「タイトル」列と「日付」列のあるスプレッドシートではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일은 Timity 백업, Timity 이벤트 또는 제목 및 날짜 열이 있는 스프레드시트가 아니에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand is geen Timity-reservekopie, geen Timity-gebeurtenis en geen spreadsheet met de kolommen Title en Date."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo não é um backup do Timity, um evento do Timity nem uma planilha com as colunas Title e Date."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
