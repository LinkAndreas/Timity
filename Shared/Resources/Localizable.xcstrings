    "Adds minutes, hours, days, weeks, months or years to a date, or working days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addiert Minuten, Stunden, Tage, Wochen, Monate oder Jahre zu einem Datum, oder Arbeitstage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma minutos, horas, días, semanas, meses o años a una fecha, o días laborables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des minutes, des heures, des jours, des semaines, des mois ou des années à une date, ou des jours ouvrés."
          }
        }
      }
    },
