    "astronomy.seeWhenTheSunRises" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wann die Sonne auf- und untergeht, wann goldene und blaue Stunde sind und wann es dämmert – dort, wo du bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See when the sun rises and sets, golden and blue hour, and twilight where you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta cuándo sale y se pone el sol, la hora dorada y la azul, y el crepúsculo donde estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez quand le soleil se lève et se couche, l’heure dorée et l’heure bleue, et le crépuscule là où vous êtes."
          }
        }
      }
    },
