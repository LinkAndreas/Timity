    "calc.timeBetween.countsTheEndDateAs" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt das Enddatum als vollen Tag mit, wie bei einem Urlaub von Montag bis Freitag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts the end date as a full day too, as for a holiday from Monday to Friday."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta también la fecha final como día completo, como en unas vacaciones de lunes a viernes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte aussi la date de fin comme un jour entier, comme pour des vacances du lundi au vendredi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta anche la data di fine come giorno intero, come per una vacanza da lunedì a venerdì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月曜日から金曜日までの休暇のように、終了日も丸1日として数えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월요일부터 금요일까지의 휴가처럼 종료일도 하루로 세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt de einddatum ook als volle dag, zoals bij een vakantie van maandag tot en met vrijdag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta também a data final como um dia inteiro, como em férias de segunda a sexta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конечная дата тоже считается полным днём — как для отпуска с понедельника по пятницу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将结束日期也计为一整天，例如从周一到周五的假期。"
          }
        }
      }
    },
    "calc.timeBetween.countsTheHoursThatReally" : {
