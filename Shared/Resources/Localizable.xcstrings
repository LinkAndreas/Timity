    "calc.timeZonePlanner.eachBarIsThatCitys" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Balken zeigt den Tag der Stadt von Mitternacht bis Mitternacht; die Linie markiert die gewählte Zeit. Wische eine Stadt nach links, um sie zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each bar is that city's day from midnight to midnight; the line marks the chosen time. Swipe left on a city to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada barra es el día de esa ciudad de medianoche a medianoche; la línea marca la hora elegida. Desliza una ciudad a la izquierda para quitarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque barre représente la journée de la ville, de minuit à minuit ; le trait marque l’heure choisie. Balaie une ville vers la gauche pour la retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni barra è la giornata di quella città da mezzanotte a mezzanotte; la linea indica l’ora scelta. Scorri a sinistra su una città per rimuoverla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各バーはその都市の0時から24時までの1日を表し、線は選択した時刻を示します。都市を削除するには左にスワイプします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 막대는 해당 도시의 자정부터 자정까지 하루를 나타내며, 선은 선택한 시간을 표시해요. 도시를 제거하려면 왼쪽으로 쓸어넘기세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke balk is de dag van die stad, van middernacht tot middernacht; de lijn markeert de gekozen tijd. Veeg een stad naar links om deze te verwijderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada barra é o dia daquela cidade, de meia-noite a meia-noite; a linha marca o horário escolhido. Deslize uma cidade para a esquerda para removê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая полоса — день в этом городе от полуночи до полуночи; линия отмечает выбранное время. Смахни город влево, чтобы удалить его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条横条代表该城市从午夜到午夜的一天；竖线标示所选时间。在城市上向左轻扫可将其移除。"
          }
        }
      }
    },
    "calc.timeZonePlanner.eachBarIsThatCitys.mac" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
