    "astronomy.ringedDaysHaveANew" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umrandete Tage haben Neumond, Halbmond oder Vollmond."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringed days have a new moon, quarter or full moon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días marcados con un círculo tienen luna nueva, cuarto creciente o menguante, o luna llena."
          }
        },
        "fr" : {
          "stringUnit" : {
