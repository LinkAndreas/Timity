            "value" : "Comptes à rebours"
          }
        }
      }
    },
    "Counting the last day treats both dates as full days, as for holidays or rentals." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem letzten Tag zählen beide Daten als volle Tage, wie bei Urlaub oder Mieten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al contar el último día, ambas fechas cuentan como días completos, como en vacaciones o alquileres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En comptant le dernier jour, les deux dates sont des journées entières, comme pour des vacances ou une location."
          }
        }
      }
    },
    "Country" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Land"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "País"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pays"
          }
        }
      }
    },
    "Counts both dates as full days, as for holidays or rentals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt beide Daten als volle Tage, wie bei Urlaub oder Mieten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta ambas fechas como días completos, como en vacaciones o alquileres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les deux dates comme des jours entiers, comme pour des vacances ou une location."
          }
        }
      }
    },
    "Counts from the first date up to, not including, the second. Only nationwide public holidays are left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt vom ersten Datum bis zum zweiten, ohne dieses. Nur bundesweite Feiertage werden ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta desde la primera fecha hasta la segunda, sin incluirla. Solo se omiten los festivos nacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte de la première date jusqu’à la seconde, non incluse. Seuls les jours fériés nationaux sont exclus."
          }
        }
      }
    },
    "Counts from the next working day. Only nationwide public holidays are left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt ab dem nächsten Arbeitstag. Nur bundesweite Feiertage werden ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta desde el siguiente día laborable. Solo se omiten los festivos nacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte à partir du jour ouvré suivant. Seuls les jours fériés nationaux sont exclus."
          }
        }
      }
    },
    "Counts the calendar days from one date to another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt die Kalendertage von einem Datum zum anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta los días naturales de una fecha a otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les jours calendaires d’une date à une autre."
          }
        }
