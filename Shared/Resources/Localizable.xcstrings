          }
        }
      }
    },
    "It's too late for %@ of sleep; this is the most still possible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für %@ Schlaf ist es zu spät; das ist das Meiste, was noch geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya es tarde para %@ de sueño; esto es lo máximo que aún es posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est trop tard pour %@ de sommeil ; c’est le maximum encore possible."
          }
        }
      }
    },
    "Go to bed now" : {
      "localizations" : {
        "de" : {
