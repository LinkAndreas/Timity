    "import.birthdaysRepeatEveryYearFor" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geburtstage wiederholen sich jedes Jahr. Bei Kontakten ohne Geburtsjahr zählt Timity ohne Altersangabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birthdays repeat every year. For contacts without a birth year, Timity counts down without showing an age."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cumpleaños se repiten cada año. Para contactos sin año de nacimiento, Timity cuenta sin mostrar la edad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anniversaires se répètent chaque année. Pour les contacts sans année de naissance, Timity décompte sans afficher d’âge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I compleanni si ripetono ogni anno. Per i contatti senza anno di nascita, Timity fa il conto alla rovescia senza mostrare l’età."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誕生日は毎年繰り返されます。生まれた年が登録されていない連絡先は、年齢を表示せずにカウントダウンします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생일은 매년 반복돼요. 출생 연도가 없는 연락처는 나이를 표시하지 않고 카운트다운해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verjaardagen herhalen elk jaar. Bij contacten zonder geboortejaar telt Timity af zonder een leeftijd te tonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os aniversários se repetem todo ano. Para contatos sem ano de nascimento, o Timity faz a contagem regressiva sem mostrar a idade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дни рождения повторяются каждый год. Для контактов без года рождения Timity ведёт обратный отсчёт, не показывая возраст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生日每年重复。对于没有出生年份的联系人，Timity 只倒计时，不显示年龄。"
          }
        }
      }
    },
