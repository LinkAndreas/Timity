          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した日付からイベントまでの待ち時間のうち、どれだけ経過したかを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 날짜부터 이벤트까지 기다린 시간이 얼마나 지났는지 보여 줘요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
