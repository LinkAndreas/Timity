    "astronomy.civilTwilightIsBrightEnough" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der bürgerlichen Dämmerung ist es draußen noch hell genug ohne Licht; am Ende der astronomischen Dämmerung ist der Himmel ganz dunkel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civil twilight is bright enough to be outside without light; at the end of astronomical twilight the sky is fully dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante el crepúsculo civil hay luz suficiente para estar fuera sin iluminación; al final del astronómico, el cielo está totalmente oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant le crépuscule civil, il fait assez clair pour sortir sans lumière ; à la fin du crépuscule astronomique, le ciel est entièrement noir."
          }
        }
      }
    },
