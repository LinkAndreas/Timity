          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › 정보 › 버전 기록에서 Timity의 모든 버전과 각 버전의 새로운 기능을 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk elke versie van Timity en wat die bracht in Instellingen › Info › Versiegeschiedenis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja todas as versões do Timity e o que cada uma trouxe em Ajustes › Sobre › Histórico de versões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотри все версии Timity и что нового в каждой в разделе «Настройки» › «О приложении» › «История версий»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”›“关于”›“版本历史”中查看 Timity 的每个版本及其带来的新内容。"
          }
        }
      }
    },
    "versionHistory.4_11_0.note2" : {
      "comment" : "Release note 2 of Timity 4.11.0, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity spricht jetzt elf Sprachen – neu sind Italienisch, Portugiesisch (Brasilien), Niederländisch, Japanisch, Koreanisch, Chinesisch (vereinfacht) und Russisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity now speaks eleven languages — new are Italian, Portuguese (Brazil), Dutch, Japanese, Korean, Chinese (Simplified) and Russian."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity ahora habla once idiomas; los nuevos son italiano, portugués (Brasil), neerlandés, japonés, coreano, chino (simplificado) y ruso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity parle désormais onze langues : l’italien, le portugais (Brésil), le néerlandais, le japonais, le coréen, le chinois (simplifié) et le russe sont nouveaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity ora parla undici lingue: le nuove sono italiano, portoghese (Brasile), olandese, giapponese, coreano, cinese (semplificato) e russo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timityが11の言語に対応しました。新たにイタリア語、ポルトガル語（ブラジル）、オランダ語、日本語、韓国語、中国語（簡体字）、ロシア語が加わりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 Timity가 11개 언어를 지원해요. 이탈리아어, 포르투갈어(브라질), 네덜란드어, 일본어, 한국어, 중국어(간체), 러시아어가 새로 추가됐어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity spreekt nu elf talen – nieuw zijn Italiaans, Portugees (Brazilië), Nederlands, Japans, Koreaans, Chinees (vereenvoudigd) en Russisch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Timity agora fala onze idiomas — os novos são italiano, português (Brasil), holandês, japonês, coreano, chinês (simplificado) e russo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity теперь говорит на одиннадцати языках — новые: итальянский, португальский (Бразилия), нидерландский, японский, корейский, китайский (упрощённый) и русский."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity 现支持 11 种语言，新增意大利语、葡萄牙语（巴西）、荷兰语、日语、韩语、简体中文和俄语。"
          }
        }
      }
    },
    "versionHistory.4_11_0.note3" : {
      "comment" : "Release note 3 of Timity 4.11.0, from the App Store's What's New, in Settings › Version History. “Describe It” is the event editor's button that fills in an event from a sentence (editor.describeIt).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri funktioniert in allen neuen Sprachen, und „Beschreiben“ versteht jetzt auch Italienisch, Portugiesisch, Niederländisch und Russisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri works in every new language, and Describe It now also understands Italian, Portuguese, Dutch and Russian."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri funciona en todos los idiomas nuevos, y «Descríbelo» ahora también entiende italiano, portugués, neerlandés y ruso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri fonctionne dans toutes les nouvelles langues, et « Décrire » comprend désormais aussi l’italien, le portugais, le néerlandais et le russe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri funziona in tutte le nuove lingue e “Descrivilo” ora capisce anche italiano, portoghese, olandese e russo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriはすべての新しい言語で使えます。「文章で入力」はイタリア語、ポルトガル語、オランダ語、ロシア語も理解するようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri는 새로 추가된 모든 언어에서 작동하고, ‘설명으로 입력’은 이제 이탈리아어, 포르투갈어, 네덜란드어, 러시아어도 이해해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri werkt in alle nieuwe talen, en ‘Beschrijf het’ begrijpt nu ook Italiaans, Portugees, Nederlands en Russisch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Siri funciona em todos os novos idiomas, e o “Descreva” agora também entende italiano, português, holandês e russo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri работает на всех новых языках, а «Описать» теперь понимает итальянский, португальский, нидерландский и русский."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 支持所有新增语言，“描述”现在也能理解意大利语、葡萄牙语、荷兰语和俄语。"
          }
        }
      }
    },
    "versionHistory.4_11_0.note4" : {
      "comment" : "Release note 4 of Timity 4.11.0, from the App Store's What's New, in Settings › Version History. The example is how 1.5 years reads in this language, as in the Age calculator's ages on other planets.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tage, Stunden, Jahre und mehr stehen in jeder Sprache in der richtigen Form, auch „1,5 Jahre“ beim Alter auf anderen Planeten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Days, hours, years and more take the right form in every language, even “1.5 years” for ages on other planets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Días, horas, años y más aparecen en la forma correcta en todos los idiomas, incluso «1,5 años» para la edad en otros planetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jours, heures, années et plus encore s’accordent correctement dans chaque langue, même « 1,5 an » pour l’âge sur d’autres planètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giorni, ore, anni e altro ancora nella forma giusta in ogni lingua, anche “1,5 anni” per l’età su altri pianeti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日、時間、年などの表記がすべての言語で正しくなりました。ほかの惑星での年齢の「1.5年」も同様です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일, 시간, 연 등이 모든 언어에서 올바르게 표시돼요. 다른 행성에서의 나이 ‘1.5년’도요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagen, uren, jaren en meer staan in elke taal in de juiste vorm, zelfs ‘1,5 jaar’ voor je leeftijd op andere planeten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dias, horas, anos e mais aparecem na forma certa em todos os idiomas, até “1,5 ano” para a idade em outros planetas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дни, часы, годы и другое — в правильной форме на каждом языке, даже «1,5 года» для возраста на других планетах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天、小时、年等在每种语言中都以正确的形式显示，包括其他行星上的年龄“1.5 年”。"
          }
        }
      }
    },
