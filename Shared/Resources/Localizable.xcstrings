    "settings.aBackupKeepsEveryDetail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Backup enthält alle Details und lässt sich wieder in Timity öffnen. Eine Tabelle öffnet sich in Numbers oder Excel. Beim Import kommen neue Ereignisse hinzu und geänderte werden aktualisiert; dieselbe Datei zweimal zu importieren ändert nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A backup keeps every detail and opens in Timity again. A spreadsheet opens in Numbers or Excel. Importing adds new events and updates changed ones; importing the same file twice changes nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia guarda todos los detalles y se vuelve a abrir en Timity. Una hoja de cálculo se abre en Numbers o Excel. Al importar se añaden los eventos nuevos y se actualizan los cambiados; importar el mismo archivo dos veces no cambia nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde conserve tous les détails et se rouvre dans Timity. Une feuille de calcul s’ouvre dans Numbers ou Excel. L’importation ajoute les nouveaux événements et met à jour ceux qui ont changé ; importer deux fois le même fichier ne change rien."
          }
        }
      }
    },
