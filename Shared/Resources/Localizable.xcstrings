    "calc.sleep.sleepComesInCyclesOf" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlaf verläuft in Zyklen von etwa 90 Minuten, bei manchen etwas kürzer oder länger. Zwischen zwei Zyklen aufzuwachen fällt leichter. Die meisten Erwachsenen brauchen 7 bis 9 Stunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep comes in cycles of about 90 minutes, a little shorter or longer for some people. Waking between them feels easier. Most adults need 7 to 9 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño va en ciclos de unos 90 minutos, algo más cortos o largos para algunas personas. Despertar entre ellos resulta más fácil. La mayoría de los adultos necesita de 7 a 9 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sommeil se déroule en cycles d’environ 90 minutes, un peu plus courts ou plus longs selon les personnes. Se réveiller entre deux cycles est plus facile. La plupart des adultes ont besoin de 7 à 9 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sonno procede in cicli di circa 90 minuti, un po’ più brevi o più lunghi per alcune persone. Svegliarsi tra un ciclo e l’altro è più facile. La maggior parte degli adulti ha bisogno di 7-9 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠は約90分のサイクルで繰り返され、人によって少し短かったり長かったりします。サイクルの合間に起きると目覚めが楽になります。ほとんどの成人には7〜9時間の睡眠が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면은 약 90분 주기로 이루어지며, 사람에 따라 조금 더 짧거나 길 수 있어요. 주기 사이에 깨면 더 쉽게 일어날 수 있어요. 대부분의 성인은 7~9시간의 수면이 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaap verloopt in cycli van ongeveer 90 minuten, bij sommige mensen iets korter of langer. Wakker worden tussen twee cycli voelt makkelijker. De meeste volwassenen hebben 7 tot 9 uur nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sono acontece em ciclos de cerca de 90 minutos, um pouco mais curtos ou mais longos para algumas pessoas. Acordar entre eles é mais fácil. A maioria dos adultos precisa de 7 a 9 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сон состоит из циклов примерно по 90 минут — у кого-то чуть короче или длиннее. Проснуться между ними легче. Большинству взрослых нужно от 7 до 9 часов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠以大约 90 分钟为一个周期，有些人稍短或稍长。在周期之间醒来会更轻松。大多数成年人需要 7 到 9 小时睡眠。"
          }
        }
      }
    },
