    "A birthday, a wedding, the day you quit smoking — any date counts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Geburtstag, eine Hochzeit, der Tag, an dem du mit dem Rauchen aufgehört hast – jedes Datum zählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cumpleaños, una boda, el día que dejaste de fumar: cualquier fecha vale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un anniversaire, un mariage, le jour où vous avez arrêté de fumer – toute date compte."
          }
        }
      }
    },
