          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A contagem começa no próximo dia útil e pula fins de semana e feriados nacionais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
