    "calc.hours.type145175" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib 1:45, 1,75 oder 1h 45m ein. Mit einem Minus davor wird Zeit abgezogen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type 1:45, 1.75 or 1h 45m. Start with a minus to take time away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe 1:45, 1,75 o 1h 45m. Empieza con un signo menos para restar tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisis 1:45, 1,75 ou 1h 45m. Commence par un signe moins pour retirer du temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci 1:45, 1,75 o 1h 45m. Inizia con un meno per sottrarre tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1:45、1.75、1h 45mのように入力します。時間を差し引くにはマイナスから入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1:45, 1.75 또는 1h 45m 형식으로 입력하세요. 빼려면 마이너스 기호로 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ 1:45, 1,75 of 1h 45m. Begin met een min om tijd af te trekken."
          }
        },
