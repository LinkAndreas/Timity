          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua cor de destaque continua como você a definiu, mesmo quando você muda o ícone do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
