    "whatsNew.planFromYourWakeUp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane ab deiner Aufwachzeit oder Schlafenszeit, mit deinem eigenen Schlafzyklus und einer abendlichen Erinnerung."
