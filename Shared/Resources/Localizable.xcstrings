    "support.timityIsFreeWithNo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity is free, with no ads and every feature included. If it’s useful to you, you can support its maintenance and the development of new features — recurring supporters get six alternative app icons as a thank-you."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity ist kostenlos, ohne Werbung und mit allen Funktionen. Wenn dir die App nützt, kannst du ihre Pflege und die Entwicklung neuer Funktionen unterstützen – als Dankeschön gibt es für regelmäßige Unterstützung sechs alternative App-Icons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity es gratis, sin anuncios y con todas las funciones. Si te resulta útil, puedes apoyar su mantenimiento y el desarrollo de nuevas funciones; como agradecimiento, el apoyo periódico incluye seis iconos alternativos de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity est gratuit, sans publicité et avec toutes ses fonctionnalités. S’il vous est utile, vous pouvez soutenir son entretien et le développement de nouvelles fonctionnalités — le soutien régulier offre en remerciement six icônes d’app alternatives."
          }
        }
      }
    },
