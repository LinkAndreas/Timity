    "whatsNew.aMoonWidgetAndComplication" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Moon widget and complication, a large Countdown widget, and progress on your Home and Lock Screen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Mond-Widget samt Komplikation, ein großes Countdown-Widget und Fortschritt auf Home- und Sperrbildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un widget y una complicación de la Luna, un widget de cuenta atrás grande y el progreso en la pantalla de inicio y de bloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un widget et une complication Lune, un grand widget Compte à rebours et la progression sur l’écran d’accueil et l’écran verrouillé."
          }
        }
      }
    },
    "whatsNew.changeTheTimeInAny" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the time in any city, see who's at work, and find the best time to meet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere die Uhrzeit in jeder Stadt, sieh, wer gerade arbeitet, und finde die beste Zeit für ein Treffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la hora en cualquier ciudad, mira quién está trabajando y encuentra la mejor hora para reunirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez l’heure dans n’importe quelle ville, voyez qui travaille et trouvez le meilleur moment pour se réunir."
          }
        }
      }
    },
    "whatsNew.eventsWithProgressShowIt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Events with progress show it on their cards, and the event page says how many days are gone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ereignisse mit Fortschritt zeigen ihn auf ihren Karten, und die Ereignisseite sagt, wie viele Tage vergangen sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos con progreso lo muestran en sus tarjetas, y la página del evento dice cuántos días han pasado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements avec progression l’affichent sur leurs cartes, et la page de l’événement indique combien de jours sont passés."
          }
        }
      }
    },
