    "astronomy.civilTwilightIsBrightEnough" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der bürgerlichen Dämmerung ist es draußen noch hell genug ohne Licht; am Ende der astronomischen Dämmerung ist der Himmel ganz dunkel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civil twilight is bright enough to be outside without light; at the end of astronomical twilight the sky is fully dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante el crepúsculo civil hay luz suficiente para estar fuera sin iluminación; al final del astronómico, el cielo está totalmente oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant le crépuscule civil, il fait assez clair pour sortir sans lumière ; à la fin du crépuscule astronomique, le ciel est entièrement noir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante il crepuscolo civile c’è ancora abbastanza luce per stare all’aperto senza illuminazione; alla fine del crepuscolo astronomico il cielo è completamente buio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市民薄明のうちは明かりがなくても屋外で過ごせる明るさです。天文薄明が終わると空は完全に暗くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시민 박명 동안에는 조명 없이도 야외 활동을 할 수 있을 만큼 밝고, 천문 박명이 끝나면 하늘이 완전히 어두워져요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens de burgerlijke schemering is het buiten nog licht genoeg zonder lamp; aan het einde van de astronomische schemering is de hemel helemaal donker."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O crepúsculo civil é claro o bastante para ficar ao ar livre sem luz; no fim do crepúsculo astronômico, o céu fica totalmente escuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В гражданские сумерки достаточно светло, чтобы быть на улице без освещения; к концу астрономических сумерек небо становится совсем тёмным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "民用晨昏蒙影时天色足够明亮，无需照明也可在户外活动；天文晨昏蒙影结束时，天空完全变暗。"
          }
        }
      }
    },
