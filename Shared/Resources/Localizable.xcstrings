        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora también en italiano, portugués, neerlandés, japonés, coreano, chino y ruso, Siri incluida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désormais aussi en italien, portugais, néerlandais, japonais, coréen, chinois et russe, Siri comprise."
          }
        },
        "it" : {
          "stringUnit" : {
