    "whatsNew.seeAnyDateInThe" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh jedes Datum im hebräischen, islamischen, chinesischen, persischen und weiteren Kalendern und starte jedes Jahr einen Countdown dafür."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See any date in the Hebrew, Islamic, Chinese, Persian and other calendars, and count down to it every year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta cualquier fecha en los calendarios hebreo, islámico, chino, persa y otros, y haz una cuenta atrás cada año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez n’importe quelle date dans les calendriers hébraïque, musulman, chinois, persan et d’autres, et faites un compte à rebours chaque année."
          }
        }
      }
    },
    "whatsNew.theSunTabNowShows" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sonnen-Tab zeigt jetzt auch den Mond: die heutige Phase, die Phasen eines ganzen Monats, Mondauf- und -untergang und die Vollmonde des Jahres."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Sun tab now shows the Moon too: today's phase, a month of phases, moonrise and moonset, and the year's full moons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pestaña del Sol ahora muestra también la Luna: la fase de hoy, las fases de todo el mes, la salida y la puesta de la Luna y las lunas llenas del año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onglet Soleil montre aussi la Lune : la phase du jour, les phases du mois, le lever et le coucher de la Lune et les pleines lunes de l’année."
          }
        }
      }
    },
    "whatsNew.timeBetweenFindADate" : {
