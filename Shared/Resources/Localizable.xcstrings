            "state" : "translated",
            "value" : "Wochenenden folgen dem Kalender deiner Region. Nur bundesweite Feiertage werden ausgelassen, keine regionalen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les week-ends suivent le calendrier de votre région. Seuls les jours fériés nationaux sont exclus, pas les régionaux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los fines de semana siguen el calendario de tu región. Solo se excluyen los festivos nacionales, no los regionales."
          }
        }
      }
    },
