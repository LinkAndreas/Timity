    "watch.addEventsInTimityOn" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add events in Timity on your iPhone or iPad. They appear here through iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Ereignisse in Timity auf deinem iPhone oder iPad hinzu. Sie erscheinen hier über iCloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade eventos en Timity en tu iPhone o iPad. Aparecen aquí a través de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des évènements dans Timity sur votre iPhone ou iPad. Ils apparaissent ici via iCloud."
          }
        }
      }
    },
    "watch.allowTimityToUseYour" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Timity to use your location in the Watch's Settings to see sunrise and sunset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Timity in den Einstellungen der Watch, deinen Standort zu verwenden, um Sonnenauf- und -untergang zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a Timity usar tu ubicación en los ajustes del Watch para ver el amanecer y el atardecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Timity à utiliser votre position dans les réglages de la Watch pour voir le lever et le coucher du soleil."
          }
        }
      }
    },
    "watch.icloudSyncIsOffIn" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sync is off in Timity on your iPhone. Turn it on there to see your events here."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Sync ist in Timity auf deinem iPhone aus. Schalte ihn dort ein, um deine Ereignisse hier zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización con iCloud está desactivada en Timity en tu iPhone. Actívala allí para ver tus eventos aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation iCloud est désactivée dans Timity sur votre iPhone. Activez-la pour voir vos évènements ici."
          }
        }
      }
    },
