          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quatorze calculadoras, agora com o Conversor de calendários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Четырнадцать калькуляторов, теперь и с конвертером календарей."
