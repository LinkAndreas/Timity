    "versionHistory.3_1_1.note1" : {
      "comment" : "Release note 1 of Timity 3.1.1, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitrechner: Ein Fehler wurde behoben, bei dem Wochen addiert statt subtrahiert wurden (vielen Dank an Steffen für den Hinweis)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time Calculator: fixed an issue where weeks were added instead of subtracted (thanks to Steffen for reporting it)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculadora de tiempo: se ha corregido un error por el que se sumaban semanas en lugar de restarlas (gracias a Steffen por avisar)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculateur de temps : correction d’un problème qui ajoutait des semaines au lieu de les soustraire (merci à Steffen de l’avoir signalé)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calcolatore di tempo: risolto un problema per cui le settimane venivano aggiunte invece che sottratte (grazie a Steffen per la segnalazione)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間計算機：週を減算するはずが加算されてしまう問題を修正しました（報告してくれたSteffenさんに感謝します）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간 계산기: 주를 빼는 대신 더하던 문제가 수정되었어요(제보해 주신 Steffen 님께 감사드려요)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdcalculator: een probleem opgelost waarbij weken werden opgeteld in plaats van afgetrokken (met dank aan Steffen voor de melding)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculadora de Tempo: corrigido um problema em que semanas eram somadas em vez de subtraídas (obrigado ao Steffen por relatar)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калькулятор времени: исправлена ошибка, из-за которой недели прибавлялись вместо вычитания (спасибо Штеффену за сообщение)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间计算器：修复了周数被加上而非减去的问题（感谢 Steffen 的反馈）。"
          }
        }
      }
    },
    "versionHistory.4_9_67.note1" : {
      "comment" : "Release note 1 of Timity 4.9.67, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity wurde von Grund auf neu entwickelt, mit komplett neuem Design und iCloud-Synchronisierung über iPhone, iPad, Mac und Apple Watch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity has been completely rebuilt from the ground up, with an all-new design and iCloud sync across iPhone, iPad, Mac and Apple Watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity se ha rehecho desde cero, con un diseño totalmente nuevo y sincronización con iCloud entre iPhone, iPad, Mac y Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity a été entièrement repensé, avec un tout nouveau design et la synchronisation iCloud entre iPhone, iPad, Mac et Apple Watch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity è stato completamente ricostruito da zero, con un design tutto nuovo e la sincronizzazione iCloud su iPhone, iPad, Mac e Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timityは一から完全に作り直されました。まったく新しいデザインになり、iPhone、iPad、Mac、Apple Watchの間でiCloud同期ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity를 처음부터 완전히 새로 만들었어요. 새로운 디자인과 함께 iPhone, iPad, Mac 및 Apple Watch 간 iCloud 동기화를 지원해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity is van de grond af opnieuw opgebouwd, met een volledig nieuw ontwerp en iCloud-synchronisatie tussen iPhone, iPad, Mac en Apple Watch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Timity foi totalmente reconstruído do zero, com um design todo novo e sincronização pelo iCloud entre iPhone, iPad, Mac e Apple Watch."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity полностью создан заново: совершенно новый дизайн и синхронизация через iCloud между iPhone, iPad, Mac и Apple Watch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity 已从零开始全面重新打造，采用全新设计，并通过 iCloud 在 iPhone、iPad、Mac 和 Apple Watch 之间同步。"
          }
        }
      }
    },
    "versionHistory.4_9_67.note2" : {
      "comment" : "Release note 2 of Timity 4.9.67, from the App Store's What's New, in Settings › Version History.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt auch als echte Mac-App, mit deinen nächsten Countdowns in der Menüleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now also a native Mac app, with your next countdowns in the menu bar."
