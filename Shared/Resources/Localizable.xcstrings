    "sync.pickWhatYouNoticeTimity" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick what you notice. Timity walks you through what helps, safest steps first. The report holds how sync is doing, not your events."
          }
        },
