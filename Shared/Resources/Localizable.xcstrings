    "Months and years keep the day where they can: one month after 31 January is the last day of February." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monate und Jahre behalten den Tag, wo es geht: Ein Monat nach dem 31. Januar ist der letzte Tag im Februar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mois et les années gardent le jour quand c’est possible : un mois après le 31 janvier, c’est le dernier jour de février."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los meses y años mantienen el día cuando pueden: un mes después del 31 de enero es el último día de febrero."
