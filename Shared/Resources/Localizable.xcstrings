    "Counts both dates as full days, as for holidays or rentals." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt beide Daten als volle Tage, wie bei Urlaub oder Mieten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta ambas fechas como días completos, como en vacaciones o alquileres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les deux dates comme des jours entiers, comme pour des vacances ou une location."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta entrambe le date come giorni interi, come per vacanze o noleggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休暇やレンタルのように、両方の日付を丸1日として数えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴가나 대여 기간처럼 두 날짜를 모두 하루로 세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt beide datums als volle dagen, zoals bij vakanties of huur."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta as duas datas como dias inteiros, como em férias ou aluguéis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обе даты считаются полными днями — как для отпуска или аренды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两个日期都计为整天，适用于假期或租期。"
          }
        }
      }
    },
    "Counts from the first date up to, not including, the second. Only nationwide public holidays are left out." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt vom ersten Datum bis zum zweiten, ohne dieses. Nur bundesweite Feiertage werden ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta desde la primera fecha hasta la segunda, sin incluirla. Solo se omiten los festivos nacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte de la première date jusqu’à la seconde, non incluse. Seuls les jours fériés nationaux sont exclus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta dalla prima data fino alla seconda, esclusa. Vengono escluse solo le festività nazionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の日付から2番目の日付の前日までを数えます。除外されるのは全国共通の祝日のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 날짜부터 두 번째 날짜 전날까지 세요. 전국 공휴일만 제외돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt vanaf de eerste datum tot de tweede, die niet meetelt. Alleen landelijke feestdagen worden overgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta da primeira data até a segunda, sem incluí-la. Só os feriados nacionais são excluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считает от первой даты до второй, не включая её. Исключаются только общегосударственные праздники."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从第一个日期算起，到第二个日期为止（不含第二个日期）。仅排除全国性公共假日。"
          }
        }
      }
    },
    "Counts from the next working day. Only nationwide public holidays are left out." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt ab dem nächsten Arbeitstag. Nur bundesweite Feiertage werden ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta desde el siguiente día laborable. Solo se omiten los festivos nacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte à partir du jour ouvré suivant. Seuls les jours fériés nationaux sont exclus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta dal giorno lavorativo successivo. Vengono escluse solo le festività nazionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の営業日から数えます。除外されるのは全国共通の祝日のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 근무일부터 세요. 전국 공휴일만 제외돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telt vanaf de volgende werkdag. Alleen landelijke feestdagen worden overgeslagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta a partir do próximo dia útil. Só os feriados nacionais são excluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсчёт начинается со следующего рабочего дня. Исключаются только общегосударственные праздники."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从下一个工作日开始计算。仅排除全国性公共假日。"
          }
        }
      }
    },
