    "Add birthdays to your contacts to import them here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deinen Kontakten Geburtstage hinzu, um sie hier zu importieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des anniversaires à vos contacts pour les importer ici."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade cumpleaños a tus contactos para importarlos aquí."
          }
        }
      }
    },
    "Add birthdays, trips and deadlines to see how long until they come — or since they happened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Geburtstage, Reisen und Fristen hinzu und sieh, wie lange es noch dauert – oder wie lange es her ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez anniversaires, voyages et échéances pour voir combien de temps il reste — ou depuis quand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade cumpleaños, viajes y plazos para ver cuánto falta, o cuánto ha pasado."
          }
        }
      }
    },
