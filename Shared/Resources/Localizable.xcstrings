          }
        }
      }
    },
    "Replace iCloud's Events with This Device's?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ereignisse in iCloud durch die dieses Geräts ersetzen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
