    "calc.workingDays.weekendsAndNationwidePublicHolidays" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochenenden und bundesweite Feiertage zählen nicht mit, das Enddatum auch nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekends and nationwide public holidays don't count, and neither does the end date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cuentan los fines de semana ni los festivos nacionales, ni tampoco la fecha final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les week-ends, les jours fériés nationaux et la date de fin ne comptent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fine settimana, festività nazionali e data di fine non vengono contati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週末と全国共通の祝日は数えません。終了日も含みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주말과 전국 공휴일은 포함되지 않으며, 종료일도 포함되지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekenden en landelijke feestdagen tellen niet mee, en de einddatum ook niet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fins de semana e feriados nacionais não contam, nem a data final."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выходные и общегосударственные праздники не учитываются, как и конечная дата."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周末和全国性公共假日不计算在内，结束日期也不计算在内。"
          }
        }
      }
    },
