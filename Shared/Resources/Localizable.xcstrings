    "astronomy.ringedDaysHaveANew" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An umrandeten Tagen ist Neumond, Halbmond oder Vollmond."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringed days have a new moon, quarter or full moon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días marcados con un círculo tienen luna nueva, cuarto creciente o menguante, o luna llena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours entourés correspondent à une nouvelle lune, un premier ou dernier quartier, ou une pleine lune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni cerchiati hanno luna nuova, primo o ultimo quarto o luna piena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丸で囲まれた日は新月、上弦・下弦の月、満月の日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동그라미가 표시된 날은 신월, 상현·하현 또는 보름달이에요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op omcirkelde dagen is het nieuwe maan, eerste of laatste kwartier of volle maan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dias circulados têm lua nova, quarto crescente ou minguante, ou lua cheia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обведённые дни — новолуние, четверть или полнолуние."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带圆圈的日期为新月、上下弦月或满月。"
          }
        }
      }
    },
