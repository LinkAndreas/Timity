    "onboarding.bringInBirthdaysAndAnniversaries" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übernimm Geburtstage und Jahrestage aus den Kontakten und anstehende Termine aus dem Kalender. Du entscheidest, welche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring in birthdays and anniversaries from Contacts and upcoming events from Calendar. You choose which ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trae cumpleaños y aniversarios de Contactos y próximos eventos de Calendario. Tú eliges cuáles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe les anniversaires et autres dates de Contacts, et les événements à venir de Calendrier. Tu choisis lesquels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa compleanni e anniversari da Contatti e gli eventi in programma da Calendario. Scegli tu quali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「連絡先」から誕生日と記念日を、「カレンダー」から今後のイベントを取り込めます。どれを取り込むかは自分で選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연락처에서 생일과 기념일을, 캘린더에서 예정된 이벤트를 가져와요. 가져올 항목은 직접 선택해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal verjaardagen en jubilea uit Contacten en komende activiteiten uit Agenda. Jij kiest welke."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traga aniversários e datas comemorativas dos Contatos e próximos eventos do Calendário. Você escolhe quais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь дни рождения и годовщины из Контактов и предстоящие события из Календаря. Выбор за тобой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从通讯录导入生日和纪念日，从日历导入即将到来的事件。由你选择导入哪些。"
          }
        }
      }
    },
    "onboarding.countDownToBirthdaysTrips" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähle bis zu Geburtstagen, Reisen und Fristen herunter – und sieh, wie lange die wichtigen Momente her sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count down to birthdays, trips and deadlines — and see how long since the moments that matter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta atrás hasta cumpleaños, viajes y plazos, y mira cuánto hace de los momentos que importan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte les jours jusqu’aux anniversaires, voyages et échéances – et vois depuis combien de temps les moments importants ont eu lieu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta alla rovescia fino a compleanni, viaggi e scadenze, e scopri quanto tempo è passato dai momenti che contano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誕生日や旅行、期限までをカウントダウン。大切な出来事からどれくらい経ったかもわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생일, 여행, 마감일까지 카운트다운하고, 소중한 순간 이후 얼마나 지났는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel af naar verjaardagen, reizen en deadlines – en zie hoelang de momenten die ertoe doen geleden zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça a contagem regressiva para aniversários, viagens e prazos — e veja quanto tempo passou desde os momentos que importam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Веди обратный отсчёт до дней рождения, поездок и сроков — и смотри, сколько прошло с важных моментов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为生日、旅行和截止日期倒计时，并查看重要时刻已过去多久。"
          }
        }
      }
    },
    "onboarding.haveYourEventsOnYour" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ereignisse auf iPhone, iPad, Mac und Apple Watch – über deinen privaten iCloud-Account. Nur du kannst sie sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have your events on your iPhone, iPad, Mac and Apple Watch alike, through your private iCloud account. Only you can see them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten tus eventos en tu iPhone, iPad, Mac y Apple Watch por igual, gracias a tu cuenta privada de iCloud. Solo tú puedes verlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retrouve tes événements sur ton iPhone, ton iPad, ton Mac et ton Apple Watch grâce à ton compte iCloud privé. Personne d’autre que toi ne peut les voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritrova i tuoi eventi su iPhone, iPad, Mac e Apple Watch tramite il tuo account iCloud privato. Solo tu puoi vederli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライベートなiCloudアカウントを通じて、iPhone、iPad、Mac、Apple Watchで同じイベントを使えます。イベントを見られるのはあなただけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비공개 iCloud 계정을 통해 iPhone, iPad, Mac 및 Apple Watch에서 이벤트를 똑같이 확인하세요. 나만 볼 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al je gebeurtenissen op je iPhone, iPad, Mac en Apple Watch, via je privé-iCloud-account. Alleen jij kunt ze zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
