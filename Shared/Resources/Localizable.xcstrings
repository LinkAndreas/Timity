          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 아이콘을 변경해도 설정한 강조 색상이 그대로 유지돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
