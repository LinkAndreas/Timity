    "calc.workingDays.countingStartsOnTheNext" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gezählt wird ab dem nächsten Arbeitstag, ohne Wochenenden und bundesweite Feiertage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counting starts on the next workday and skips weekends and nationwide public holidays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recuento empieza el siguiente día laborable y omite fines de semana y festivos nacionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le décompte commence au prochain jour ouvré et exclut les week-ends et les jours fériés nationaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il conteggio inizia dal giorno lavorativo successivo ed esclude fine settimana e festività nazionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の営業日から数え始め、週末と全国共通の祝日を除きます。"
