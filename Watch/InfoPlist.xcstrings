    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity verwendet deinen Standort, um Sonnenaufgang, Sonnenuntergang und Dämmerung für deinen Ort zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Timity uses your location to calculate sunrise, sunset and twilight where you are."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity utilise votre position pour calculer le lever et le coucher du soleil et le crépuscule là où vous êtes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timity usa tu ubicación para calcular el amanecer, el atardecer y el crepúsculo donde estás."
          }
        }
      }
    }
  },
  "version" : "1.0"
